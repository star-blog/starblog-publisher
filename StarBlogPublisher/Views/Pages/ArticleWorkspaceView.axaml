<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:StarBlogPublisher.ViewModels" xmlns:fi="using:FluentIcons.Avalonia.Fluent" xmlns:views="using:StarBlogPublisher.Views" xmlns:controls="using:StarBlogPublisher.Views.Controls" x:Class="StarBlogPublisher.Views.ArticleWorkspaceView" x:DataType="vm:ArticleWorkspaceViewModel" DragDrop.AllowDrop="True">
  <UserControl.Styles>
    <Style Selector="Button.FileRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,3"/><Setter Property="MinHeight" Value="25"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style Selector="Button.SidebarIcon"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="MinWidth" Value="25"/><Setter Property="MinHeight" Value="25"/></Style>
    <Style Selector="Button.SidebarClose"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2"/><Setter Property="MinWidth" Value="20"/><Setter Property="MinHeight" Value="20"/><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="ListBox.SidebarDocuments ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="MinHeight" Value="27"/></Style>
    <Style Selector="ListBox.SidebarDocuments ListBoxItem /template/ ContentPresenter"><Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="3"/></Style>
    <Style Selector="ListBox.SidebarDocuments ListBoxItem:selected /template/ ContentPresenter, ListBox.SidebarDocuments ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Style>
    <Style Selector="ListBox.SidebarDocuments ListBoxItem:selected Button.SidebarClose, ListBox.SidebarDocuments ListBoxItem:pointerover Button.SidebarClose"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="TreeView.ExplorerTree"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="TreeView.ExplorerTree TreeViewItem"><Setter Property="MinHeight" Value="25"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.DocumentTabs ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="ListBox.DocumentTabs ListBoxItem:selected /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="BorderThickness" Value="0,2,0,0"/></Style>
  </UserControl.Styles>
  <DockPanel>
    <controls:WorkspaceStatusBar DockPanel.Dock="Bottom" DataContext="{Binding CurrentDocument}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarColumnWidth}"/><ColumnDefinition Width="{Binding SidebarSplitterColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" IsVisible="{Binding IsSidebarOpen}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid Margin="8,7" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,2,6"><TextBlock Text="资源管理器" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="SidebarIcon" Command="{Binding NewDocumentCommand}" ToolTip.Tip="新建文章"><fi:FluentIcon Icon="DocumentAdd" IconVariant="Regular" FontSize="15"/></Button><Button Grid.Column="2" Classes="SidebarIcon" Command="{Binding OpenFilesCommand}" ToolTip.Tip="打开文章"><fi:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="15"/></Button></Grid>
          <ToggleButton Grid.Row="1" IsChecked="{Binding IsOpenDocumentsExpanded}" Background="Transparent" BorderThickness="0" Padding="5,4" HorizontalContentAlignment="Left"><Grid ColumnDefinitions="Auto,*,Auto"><fi:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="13" IsVisible="{Binding IsOpenDocumentsExpanded}"/><fi:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="13" IsVisible="{Binding !IsOpenDocumentsExpanded}"/><TextBlock Grid.Column="1" Text="已打开的编辑器" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Documents.Count}" Opacity="0.6" FontSize="11"/></Grid></ToggleButton>
          <ListBox Grid.Row="2" Classes="SidebarDocuments" IsVisible="{Binding IsOpenDocumentsExpanded}" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" Background="Transparent" BorderThickness="0" MaxHeight="145" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PublishViewModel"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"><fi:FluentIcon Icon="Document" IconVariant="Regular" FontSize="15" Opacity="0.75" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DocumentFileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding CurrentFilePath}"/><Grid Grid.Column="2" Width="20" Height="20"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}" IsVisible="{Binding IsDocumentDirty}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Content="×" Classes="SidebarClose" Click="OnCloseTab" ToolTip.Tip="关闭文章"/></Grid></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ToggleButton Grid.Row="3" IsChecked="{Binding IsWorkspaceTreeExpanded}" Background="Transparent" BorderThickness="0" Padding="5,4" HorizontalContentAlignment="Left"><Grid ColumnDefinitions="Auto,*"><fi:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="13" IsVisible="{Binding IsWorkspaceTreeExpanded}"/><fi:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="13" IsVisible="{Binding !IsWorkspaceTreeExpanded}"/><TextBlock Grid.Column="1" Text="{Binding WorkspaceRootName}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" ToolTip.Tip="{Binding WorkspaceRootPath}"/></Grid></ToggleButton>
          <TreeView Grid.Row="4" Classes="ExplorerTree" IsVisible="{Binding IsWorkspaceTreeExpanded}" ItemsSource="{Binding WorkspaceFiles}" SelectionChanged="OnWorkspaceTreeSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><TreeView.ItemTemplate><TreeDataTemplate DataType="vm:ArticleWorkspaceTreeNode" ItemsSource="{Binding Children}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="5"><fi:FluentIcon Icon="Folder" IconVariant="Regular" FontSize="15" IsVisible="{Binding IsDirectory}"/><fi:FluentIcon Icon="Document" IconVariant="Regular" FontSize="15" IsVisible="{Binding !IsDirectory}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" VerticalAlignment="Center"/></Grid></TreeDataTemplate></TreeView.ItemTemplate></TreeView>
          <ToggleButton Grid.Row="5" IsChecked="{Binding IsOutlineExpanded}" Background="Transparent" BorderThickness="0" Padding="5,5,4,4" HorizontalContentAlignment="Left"><Grid ColumnDefinitions="Auto,*"><fi:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="13" IsVisible="{Binding IsOutlineExpanded}"/><fi:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="13" IsVisible="{Binding !IsOutlineExpanded}"/><TextBlock Grid.Column="1" Text="文章大纲" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"/></Grid></ToggleButton>
          <ScrollViewer Grid.Row="6" IsVisible="{Binding IsOutlineExpanded}" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding CurrentDocument.OutlineEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ArticleHeading"><Button HorizontalAlignment="Stretch" Classes="FileRow" Click="OnOutlineClick" Margin="{Binding Indentation}" ToolTip.Tip="{Binding Title}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" IsVisible="{Binding IsSidebarOpen}" Width="4" Background="Transparent" ResizeDirection="Columns"/>
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsTaskPanelOpen}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Height="180"><DockPanel Margin="12,6"><Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Text="文章任务与状态" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Command="{Binding ToggleTasksCommand}" Classes="Transparent" Padding="6,0" ToolTip.Tip="关闭任务面板"/></Grid><TextBlock Text="打开文章后可在这里查看各篇文章的任务状态。" IsVisible="{Binding !HasDocuments}" Opacity="0.65"/><ScrollViewer IsVisible="{Binding HasDocuments}"><ItemsControl ItemsSource="{Binding Documents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PublishViewModel"><Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2,0,6"><Button Classes="FileRow" Click="OnTaskActivate" HorizontalContentAlignment="Left"><TextBlock Text="{Binding DocumentDisplayName}" TextTrimming="CharacterEllipsis"/></Button><TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/><Button Grid.Column="2" Content="查看结果" IsVisible="{Binding HasPublishResult}" Click="OnTaskResult" Classes="FileRow"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding PublishProgress}" IsVisible="{Binding IsPublishing}" Height="2"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
        <ListBox DockPanel.Dock="Top" Classes="DocumentTabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" IsVisible="{Binding HasDocuments}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PublishViewModel"><Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="12,5,5,5"><Border.ContextMenu><ContextMenu><MenuItem Header="保存" Command="{Binding SaveDocumentCommand}"/><MenuItem Header="另存为…" Tag="saveAs" Click="OnTabMenuClick"/><Separator/><MenuItem Header="关闭" Tag="close" Click="OnTabMenuClick"/><MenuItem Header="关闭其他标签" Tag="others" Click="OnTabMenuClick"/><MenuItem Header="关闭右侧标签" Tag="right" Click="OnTabMenuClick"/><Separator/><MenuItem Header="复制文件路径" Tag="path" Click="OnTabMenuClick"/></ContextMenu></Border.ContextMenu><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding DocumentDisplayName}" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding CurrentFilePath}"/><TextBlock Text="发布中" IsVisible="{Binding IsPublishing}" VerticalAlignment="Center" FontSize="11"/><Button Content="×" Classes="Transparent" Padding="5,0" MinHeight="24" Click="OnCloseTab" ToolTip.Tip="关闭文章"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        <views:PublishView DataContext="{Binding CurrentDocument}"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
