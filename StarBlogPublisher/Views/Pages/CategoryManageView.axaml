<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             x:Class="StarBlogPublisher.Views.CategoryManageView"
             x:DataType="vm:CategoryManageViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" Margin="32,8,32,24" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="分类管理" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="改名、隐藏或删除站点分类。分类下仍有文章时不能删除。"
                               Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:FluentIcon Icon="Add" IconVariant="Regular" />
                            <TextBlock Text="新建" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Text="刷新" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="16" MinHeight="320">
                <Border Classes="Card" Padding="8">
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryManageItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                                    <TextBlock Text="{Binding IndentedName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding VisibilityText}" FontSize="12" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="1" Classes="Card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="选中分类" FontWeight="SemiBold" />
                        <TextBlock Text="名称" Opacity="0.75" FontSize="12" />
                        <TextBox Text="{Binding EditName}" IsEnabled="{Binding HasSelection}" />
                        <CheckBox IsChecked="{Binding EditVisible}" Content="前台可见" IsEnabled="{Binding HasSelection}" />
                        <Button Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSave}">
                            <TextBlock Text="保存名称与可见性" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding ToggleVisibleCommand}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasSelection}">
                            <TextBlock Text="切换显隐" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasSelection}">
                            <TextBlock Text="删除" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.75" />
        </Grid>
        <controls:BusyOverlay IsBusy="{Binding IsBusy}" Message="{Binding StatusMessage}" />
    </Panel>
</UserControl>
