<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="StarBlogPublisher.Views.PublishEditorView"
             x:DataType="vm:PublishViewModel">

    <Panel DragDrop.AllowDrop="True">
        <Grid IsVisible="{Binding !HasLoadedArticle}"
              DragDrop.AllowDrop="True">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420"
                    Padding="32,28"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <fi:FluentIcon Icon="DocumentAdd"
                                   IconVariant="Regular"
                                   FontSize="40"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="拖放 Markdown 文件到此处"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="或"
                               Opacity="0.55"
                               HorizontalAlignment="Center" />
                    <Button Content="打开文件"
                            Classes="Accent"
                            HorizontalAlignment="Center"
                            Command="{Binding SelectFileCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Classes="WorkspaceLoaded"
                   IsVisible="{Binding HasLoadedArticle}">
            <controls:WorkspaceStatusBar DockPanel.Dock="Bottom" />

            <Border DockPanel.Dock="Top"
                    Padding="12,6,12,6"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DocumentDisplayName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CurrentFilePath}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Command="{Binding PreviewCommand}"
                            IsEnabled="{Binding CanPublish}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:FluentIcon Icon="Eye" IconVariant="Regular" FontSize="14" />
                            <TextBlock Text="预览" />
                        </StackPanel>
                    </Button>
                    <SplitButton Content="发布"
                                 Classes="Accent"
                                 Command="{Binding PublishCommand}"
                                 IsEnabled="{Binding CanPublish}">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="发布到 StarBlog" Command="{Binding PublishCommand}" />
                                <MenuItem Header="发布并打开网页" Command="{Binding PublishAndOpenCommand}" />
                                <MenuItem Header="复制发布链接" Command="{Binding CopyPublishLinkCommand}" />
                                <MenuItem Header="查看发布结果" Command="{Binding ShowPublishResultCommand}" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button IsVisible="{Binding IsAIEnabled}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="14" />
                            <TextBlock Text="AI" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="生成摘要" Command="{Binding RegenerateDescriptionCommand}" />
                                <MenuItem Header="生成关键词" Command="{Binding GenerateKeywordsCommand}" />
                                <MenuItem Header="生成 Slug" Command="{Binding GenerateSlugCommand}" />
                                <MenuItem Header="生成封面" Command="{Binding ShowCoverPromptCommand}" />
                                <MenuItem Header="分析文章图片" Command="{Binding AnalyzeImagesCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button ToolTip.Tip="更多">
                        <fi:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="复制 Markdown" Command="{Binding CopyContentCommand}" />
                                <MenuItem Header="生成封面" Command="{Binding ShowCoverPromptCommand}" />
                                <MenuItem Header="分析图片" Command="{Binding AnalyzeImagesCommand}" />
                                <MenuItem Header="重新加载" Command="{Binding ReloadDocumentCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Command="{Binding ToggleInspectorCommand}"
                            IsVisible="{Binding UseOverlayInspector}"
                            ToolTip.Tip="文章属性">
                        <fi:FluentIcon Icon="PanelRight" IconVariant="Regular" FontSize="16" />
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <SplitView DisplayMode="{Binding InspectorDisplayMode}"
                       PanePlacement="Right"
                       OpenPaneLength="336"
                       CompactPaneLength="0"
                       IsPaneOpen="{Binding IsInspectorOpen, Mode=TwoWay}">
                <SplitView.Pane>
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                        <controls:ArticleInspectorView />
                    </Border>
                </SplitView.Pane>
                <controls:MarkdownEditorView />
            </SplitView>
        </DockPanel>

        <controls:BusyOverlay IsBusy="{Binding IsWorkspaceBusy}"
                              Message="{Binding WorkspaceBusyMessage}"
                              Progress="{Binding PublishProgress}"
                              IsIndeterminate="{Binding IsWorkspaceBusyIndeterminate}"
                              ZIndex="10" />
    </Panel>
</UserControl>
