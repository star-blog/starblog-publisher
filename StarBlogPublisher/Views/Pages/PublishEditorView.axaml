<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="StarBlogPublisher.Views.PublishEditorView"
             x:DataType="vm:PublishViewModel">

    <Panel DragDrop.AllowDrop="True">
        <Grid IsVisible="{Binding !HasLoadedArticle}"
              DragDrop.AllowDrop="True">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420" Margin="20"
                    Padding="32,28"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <fi:FluentIcon Icon="DocumentAdd"
                                   IconVariant="Regular"
                                   FontSize="40"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="拖放 Markdown 文件到此处"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="或"
                               Opacity="0.55"
                               HorizontalAlignment="Center" />
                    <Button Content="打开文件"
                            Classes="Accent"
                            HorizontalAlignment="Center"
                            Command="{Binding SelectFileCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Classes="WorkspaceLoaded"
                   IsVisible="{Binding HasLoadedArticle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="{Binding InspectorColumnWidth, Mode=TwoWay}" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="10,3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding BreadcrumbText}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Opacity="0.7" ToolTip.Tip="{Binding CurrentFilePath}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <ToggleButton Content="源码" Padding="6,2" MinHeight="25" FontSize="11" IsChecked="{Binding IsSourceMode, Mode=OneWay}" Command="{Binding SetEditorModeCommand}" CommandParameter="Source" />
                                <ToggleButton Content="分栏" Padding="6,2" MinHeight="25" FontSize="11" IsEnabled="{Binding CanPreview}" IsChecked="{Binding IsSplitMode, Mode=OneWay}" Command="{Binding SetEditorModeCommand}" CommandParameter="Split" />
                                <ToggleButton Content="预览" Padding="6,2" MinHeight="25" FontSize="11" IsEnabled="{Binding CanPreview}" IsChecked="{Binding IsPreviewMode, Mode=OneWay}" Command="{Binding SetEditorModeCommand}" CommandParameter="Preview" />
                                <Button Padding="6,2" MinHeight="25" ToolTip.Tip="字体、换行与行号">
                                    <fi:FluentIcon Icon="TextFont" FontSize="14" />
                                    <Button.Flyout><Flyout><controls:EditorOptionsPanel /></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:MarkdownEditorView />
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" IsVisible="{Binding IsInspectorOpen}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding IsInspectorOpen}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <Panel>
                        <controls:ArticleInspectorView IsVisible="{Binding IsInspectorOpen}" />
                    </Panel>
                </Border>
            </Grid>
        </DockPanel>

        <controls:BusyOverlay IsBusy="{Binding IsWorkspaceBusy}"
                              Message="{Binding WorkspaceBusyMessage}"
                              Progress="{Binding PublishProgress}"
                              IsIndeterminate="{Binding IsWorkspaceBusyIndeterminate}"
                              ZIndex="10" />
    </Panel>
</UserControl>
