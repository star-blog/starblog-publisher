<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:converters="using:StarBlogPublisher.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StarBlogPublisher.Views.ImageGalleryView"
             x:DataType="vm:ImageGalleryViewModel"
             x:Name="GalleryRoot">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8">
        <TextBlock Text="{Binding ImageCount, StringFormat='共 {0} 张图片'}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ScrollViewer Grid.Row="1" Margin="0,8">
            <ItemsControl ItemsSource="{Binding Images}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Card" Margin="6" Padding="10" MaxWidth="250"
                                BorderBrush="{Binding Exists, Converter={x:Static converters:BooleanToValueConverter.Instance}, ConverterParameter='Transparent|#F44336'}"
                                BorderThickness="{Binding Exists, Converter={x:Static converters:BooleanToValueConverter.Instance}, ConverterParameter='0|2'}">
                            <StackPanel Spacing="8">
                                <Border CornerRadius="4" ClipToBounds="True" MaxHeight="200">
                                    <Grid>
                                        <Image Source="{Binding ImageBitmap}" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="#80000000" CornerRadius="4" IsVisible="{Binding !Exists}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <fi:FluentIcon Icon="QuestionCircle" IconVariant="Regular" FontSize="32" />
                                                <TextBlock Text="文件不存在" FontWeight="Bold" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding FileSize}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button FontSize="10" Padding="8,4"
                                            Command="{Binding #GalleryRoot.((vm:ImageGalleryViewModel)DataContext).OpenFolderCommand}"
                                            CommandParameter="{Binding FilePath}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <fi:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="10" />
                                            <TextBlock Text="打开" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button FontSize="10" Padding="8,4"
                                            Command="{Binding #GalleryRoot.((vm:ImageGalleryViewModel)DataContext).CopyPathCommand}"
                                            CommandParameter="{Binding FilePath}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <fi:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="10" />
                                            <TextBlock Text="复制" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Padding="10,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <fi:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
