<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:converters="using:StarBlogPublisher.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StarBlogPublisher.Views.ImageGalleryView"
             x:DataType="vm:ImageGalleryViewModel"
             x:Name="GalleryRoot">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <i:Icon Value="fa-solid fa-images" Foreground="#4CAF50" />
            <TextBlock Text="文章图片画廊" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding ImageCount, StringFormat='共 {0} 张图片'}"
                       VerticalAlignment="Center" Foreground="{DynamicResource SukiLowText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Images}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <suki:GlassCard Margin="6" Padding="10" MaxWidth="250"
                                        BorderBrush="{Binding Exists, Converter={x:Static converters:BooleanToValueConverter.Instance}, ConverterParameter='Transparent|#F44336'}"
                                        BorderThickness="{Binding Exists, Converter={x:Static converters:BooleanToValueConverter.Instance}, ConverterParameter='0|2'}">
                            <StackPanel Spacing="8">
                                <Border CornerRadius="4" ClipToBounds="True" MaxHeight="200">
                                    <Grid>
                                        <Image Source="{Binding ImageBitmap}" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="#80000000" CornerRadius="4" IsVisible="{Binding !Exists}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <i:Icon Value="fa-solid fa-exclamation-triangle" Foreground="#F44336" FontSize="32" />
                                                <TextBlock Text="文件不存在" Foreground="#F44336" FontWeight="Bold" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource SukiLowText}"
                                           TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding FileSize}" FontSize="10" Foreground="{DynamicResource SukiLowText}" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Classes="Basic" FontSize="10" Padding="8,4"
                                            Command="{Binding #GalleryRoot.((vm:ImageGalleryViewModel)DataContext).OpenFolderCommand}"
                                            CommandParameter="{Binding FilePath}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <i:Icon Value="fa-solid fa-folder-open" FontSize="10" />
                                            <TextBlock Text="打开" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="Basic" FontSize="10" Padding="8,4"
                                            Command="{Binding #GalleryRoot.((vm:ImageGalleryViewModel)DataContext).CopyPathCommand}"
                                            CommandParameter="{Binding FilePath}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <i:Icon Value="fa-solid fa-copy" FontSize="10" />
                                            <TextBlock Text="复制" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </suki:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Classes="Basic" Padding="10,5">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <i:Icon Value="fa-solid fa-rotate-right" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
