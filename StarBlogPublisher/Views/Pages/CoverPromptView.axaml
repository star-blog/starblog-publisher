<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:utils="clr-namespace:StarBlogPublisher.Utils;assembly=StarBlogPublisher.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="StarBlogPublisher.Views.CoverPromptView"
             x:DataType="vm:CoverPromptViewModel">
    <ScrollViewer Margin="16">
        <StackPanel Spacing="12" MaxWidth="760">
            <TextBlock Text="封面风格" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding CoverStyleOptions}"
                          SelectedItem="{Binding SelectedTemplate}"
                          IsEnabled="{Binding IsAIEnabled}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="utils:PromptTemplate">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" ToolTip.Tip="生成 AI 画图提示词"
                        Command="{Binding GeneratePromptCommand}"
                        IsVisible="{Binding IsAIEnabled}" Classes="Accent" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="生成" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="提示词" FontWeight="SemiBold" />
            <TextBox Text="{Binding GeneratedPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinLines="12" Watermark="生成的封面提示词会显示在这里" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
