<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="420"
             MinWidth="360" MaxWidth="560"
             x:Class="StarBlogPublisher.Views.AddCategoryView"
             x:DataType="vm:AddCategoryViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="4" RowSpacing="16">
        <StackPanel Spacing="8">
            <TextBlock Text="分类名称" FontWeight="SemiBold" />
            <TextBox Text="{Binding CategoryName}"
                     PlaceholderText="请输入分类名称"
                     MaxLength="50" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" MinHeight="220" MaxHeight="420">
            <TextBlock Text="选择父级分类" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedParentCategory}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Nodes}">
                        <TextBlock Text="{Binding Text}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Command="{Binding ConfirmCommand}" Classes="Accent">添加分类</Button>
        </StackPanel>
    </Grid>
</UserControl>
