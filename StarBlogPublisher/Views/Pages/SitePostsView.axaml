<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:models="using:StarBlogPublisher.Models"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             x:Class="StarBlogPublisher.Views.SitePostsView"
             x:DataType="vm:SitePostsViewModel">
    <controls:StackPageHost Breadcrumbs="{Binding Breadcrumbs}"
                            IsNavigating="{Binding IsStackNavigating}"
                            StackContent="{Binding ActiveStackPage}"
                            BreadcrumbClicked="OnBreadcrumbClicked">
        <controls:StackPageHost.RootContent>
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,24" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="站点文章" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="查看、更新和删除已经发布到 StarBlog 的文章。本地写作仍在「文章」工作区。"
                                   Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding OpenCategoriesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:FluentIcon Icon="Folder" IconVariant="Regular" />
                                <TextBlock Text="分类管理" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="搜索标题"
                             KeyDown="OnSearchKeyDown" />
                    <ComboBox Grid.Column="1" MinWidth="140"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SitePostStatusFilter">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="2" MinWidth="180"
                              ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="3" Command="{Binding SearchCommand}" Classes="Accent" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Text="筛选" />
                    </Button>
                </Grid>

                <Panel Grid.Row="2" MinHeight="280">
                    <ListBox ItemsSource="{Binding Posts}"
                             SelectedItem="{Binding SelectedPost}"
                             DoubleTapped="OnPostDoubleTapped">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SitePostListItem">
                                <Border Padding="12,10" Margin="0,2" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding Slug}" FontSize="12" Opacity="0.55" FontFamily="Consolas" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="Chip" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedAt}" FontSize="12"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:BusyOverlay IsBusy="{Binding IsBusy}" Message="{Binding StatusMessage}" />
                </Panel>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding PageSummary}" Opacity="0.75" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding OpenSelectedCommand}"
                            IsEnabled="{Binding HasSelectedPost}">
                        <TextBlock Text="打开" />
                    </Button>
                    <Button Grid.Column="2" Command="{Binding GoPreviousCommand}" IsEnabled="{Binding CanGoPrevious}">
                        <TextBlock Text="上一页" />
                    </Button>
                    <Button Grid.Column="3" Command="{Binding GoNextCommand}" IsEnabled="{Binding CanGoNext}">
                        <TextBlock Text="下一页" />
                    </Button>
                </Grid>
            </Grid>
        </controls:StackPageHost.RootContent>
    </controls:StackPageHost>
</UserControl>
