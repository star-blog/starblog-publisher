<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:StarBlogPublisher.ViewModels" xmlns:models="using:StarBlogPublisher.Models"
 xmlns:fi="using:FluentIcons.Avalonia.Fluent" xmlns:controls="using:StarBlogPublisher.Views.Controls"
 x:Class="StarBlogPublisher.Views.CoverStudioView" x:DataType="vm:CoverStudioViewModel" x:Name="StudioRoot">
 <UserControl.Styles>
  <Style Selector="TextBlock.Label"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.Hint"><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="Button.Action"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Button.Tool"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="ToggleButton.Tool"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Expander"><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="Expander /template/ ToggleButton"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Slider"><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="24"/></Style>
 </UserControl.Styles>
 <DockPanel>
  <Border DockPanel.Dock="Top" Height="44" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource WorkspaceChromeBrush}">
   <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="12,0">
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
     <Button Classes="Tool" Command="{Binding UndoCommand}" ToolTip.Tip="撤销 · Ctrl+Z" AutomationProperties.Name="撤销"><fi:FluentIcon Icon="ArrowUndo" FontSize="15"/></Button>
     <Button Classes="Tool" Command="{Binding RedoCommand}" ToolTip.Tip="重做 · Ctrl+Y" AutomationProperties.Name="重做"><fi:FluentIcon Icon="ArrowRedo" FontSize="15"/></Button>
    </StackPanel>
    <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
     <ToggleButton Classes="Tool" Content="文字" IsChecked="{Binding IsTextTarget, Mode=OneWay}" Command="{Binding SetDragTargetCommand}" CommandParameter="文字" ToolTip.Tip="点击文字后拖动"/>
     <ToggleButton Classes="Tool" Content="背景" IsChecked="{Binding IsBackgroundTarget, Mode=OneWay}" Command="{Binding SetDragTargetCommand}" CommandParameter="背景" ToolTip.Tip="拖动背景，滚轮缩放"/>
     <ToggleButton Classes="Tool" IsChecked="{Binding ShowGuides}" ToolTip.Tip="显示裁切参考线" AutomationProperties.Name="裁切参考线"><fi:FluentIcon Icon="Grid" FontSize="15"/></ToggleButton>
    </StackPanel>
    <TextBlock Grid.Column="3" Text="{Binding TemplateName}" Classes="Hint" VerticalAlignment="Center" Margin="8,0"/>
    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <Button Classes="Action" Command="{Binding SaveArticleCommand}" Content="保存" ToolTip.Tip="保存文章与封面设计 · Ctrl+S"/>
     <Button Classes="Action" Content="导出" IsEnabled="{Binding IsEditable}">
      <Button.Flyout><Flyout><StackPanel Width="230" Spacing="10">
       <TextBlock Text="导出封面" FontSize="13" FontWeight="SemiBold"/>
       <Grid ColumnDefinitions="60,*"><TextBlock Classes="Label" Text="格式"/><ComboBox Grid.Column="1" SelectedItem="{Binding ExportFormat}"><x:String>JPEG</x:String><x:String>PNG</x:String></ComboBox></Grid>
       <Grid ColumnDefinitions="60,*"><TextBlock Classes="Label" Text="范围"/><ComboBox Grid.Column="1" SelectedItem="{Binding ExportRange}"><x:String>完整画布</x:String><x:String>头条</x:String><x:String>次条</x:String></ComboBox></Grid>
       <Button Classes="Accent Action" Content="导出图片…" Command="{Binding SaveImageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      </StackPanel></Flyout></Button.Flyout>
     </Button>
     <Button Classes="Accent Action" Content="应用到文章" Command="{Binding ApplyToWeChatCommand}" IsEnabled="{Binding IsEditable}"/>
     <Button Classes="Tool" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="封面设置" AutomationProperties.Name="封面设置"><fi:FluentIcon Icon="PanelRight" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Classes="StatusBar">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
    <TextBlock Text="{Binding SaveHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="2" Text="1200 × 900" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </Grid>
  </Border>
  <Grid ColumnDefinitions="*,Auto">
   <Grid RowDefinitions="*,Auto" Background="{DynamicResource WorkspaceChromeBrush}">
    <Border Margin="24,20,24,12" ClipToBounds="True">
     <controls:CoverCanvas x:Name="CanvasImage" AutomationProperties.Name="封面编辑画布"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="20,0,20,16" Spacing="8">
     <TextBlock Classes="Hint" Text="发布预览" HorizontalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5" Background="{DynamicResource InspectorBackgroundBrush}">
       <Grid RowDefinitions="Auto,*" RowSpacing="4"><TextBlock Classes="Hint" Text="头条 · 2.35:1"/><controls:CoverCanvas Grid.Row="1" Frame="Headline" Width="235" Height="100" IsHitTestVisible="False"/></Grid>
      </Border>
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5" Background="{DynamicResource InspectorBackgroundBrush}">
       <Grid RowDefinitions="Auto,*" RowSpacing="4"><TextBlock Classes="Hint" Text="次条 · 1:1"/><controls:CoverCanvas Grid.Row="1" Frame="Secondary" Width="100" Height="100" IsHitTestVisible="False"/></Grid>
      </Border>
     </StackPanel>
    </StackPanel>
   </Grid>
   <Border Grid.Column="1" Width="320" IsVisible="{Binding IsInspectorOpen}" Background="{DynamicResource InspectorBackgroundBrush}"
    BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
    <DockPanel>
     <Border DockPanel.Dock="Top" Height="40" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,8,0">
       <TextBlock Text="封面设置" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Classes="Tool" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="收起设置"><fi:FluentIcon Icon="Dismiss" FontSize="14"/></Button>
      </Grid>
     </Border>
     <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel IsEnabled="{Binding IsEditable}">
       <ToggleButton Classes="SectionHeader" Content="模板" IsChecked="True" x:Name="TemplateSection"/>
       <StackPanel Margin="12,8,12,14" Spacing="8" IsVisible="{Binding #TemplateSection.IsChecked}">
        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedCoverTemplate}" DisplayMemberBinding="{Binding Name}"/>
       </StackPanel>
       <ToggleButton Classes="SectionHeader" Content="背景" IsChecked="True" x:Name="BackgroundSection"/>
       <StackPanel Margin="12,8,12,14" Spacing="8" IsVisible="{Binding #BackgroundSection.IsChecked}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
         <Button Classes="Action" Command="{Binding SelectLocalBackgroundCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><fi:FluentIcon Icon="FolderOpen" FontSize="14"/><TextBlock Text="本地图片"/></StackPanel></Button>
         <Button Grid.Column="1" Classes="Action" Content="{Binding ArticleImagePickerLabel}" Command="{Binding ShowArticleImagesCommand}" IsEnabled="{Binding HasArticleImages}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
        <TextBlock Classes="Hint" Text="{Binding BackgroundDescription}" TextTrimming="CharacterEllipsis"/>
        <StackPanel Spacing="6" IsVisible="{Binding HasBackground}">
         <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="Label" Text="缩放"/><TextBlock Grid.Column="1" Classes="Hint" Text="{Binding Zoom, StringFormat={}{0:0.0}×}"/></Grid>
         <Slider Minimum="1" Maximum="4" Value="{Binding Zoom}" PointerReleased="OnGestureEnd"/>
         <StackPanel Orientation="Horizontal" Spacing="6"><Button Classes="Action" Content="重置位置" Command="{Binding ResetBackgroundCommand}"/><Button Classes="Action" Content="移除" Command="{Binding ClearBackgroundCommand}"/></StackPanel>
        </StackPanel>
        <Expander Header="在线图片"><StackPanel Spacing="8" Margin="0,8,0,0">
         <ComboBox ItemsSource="{Binding RandomCoverProviders}" SelectedItem="{Binding SelectedRandomCoverProvider}" DisplayMemberBinding="{Binding Name}"/>
         <Button Classes="Action" Content="换一张随机图" Command="{Binding PickRandomBackgroundCommand}" IsEnabled="{Binding !IsFetchingRandomBackground}"/>
        </StackPanel></Expander>
       </StackPanel>
       <ToggleButton Classes="SectionHeader" Content="文字" IsChecked="True" x:Name="TextSection"/>
       <StackPanel Margin="12,8,12,14" Spacing="8" IsVisible="{Binding #TextSection.IsChecked}">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="Label" Text="封面标题"/><Button Grid.Column="1" Classes="Tool" Command="{Binding SyncTitleCommand}" ToolTip.Tip="从文章同步标题"><fi:FluentIcon Icon="ArrowSync" FontSize="14"/></Button></Grid>
        <TextBox Text="{Binding CoverTitle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="112" IsUndoEnabled="False"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="Label" Text="字号"/><TextBlock Grid.Column="1" Classes="Hint" Text="{Binding FontSize, StringFormat={}{0:0}}"/></Grid>
        <Slider Minimum="24" Maximum="96" Value="{Binding FontSize}" PointerReleased="OnGestureEnd"/>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
         <TextBox Text="{Binding TextColor}" PlaceholderText="#FFFFFF" IsUndoEnabled="False"/>
         <ToggleButton Grid.Column="1" Classes="Tool" Content="B" FontWeight="Bold" IsChecked="{Binding IsBold}" ToolTip.Tip="加粗"/>
         <ToggleButton Grid.Column="2" Classes="Tool" Content="居中" IsChecked="{Binding Centered}" ToolTip.Tip="水平居中"/>
        </Grid>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
         <Button Classes="Action" Content="靠上" Command="{Binding SetTextPlacementCommand}" CommandParameter="top" HorizontalAlignment="Stretch"/>
         <Button Grid.Column="1" Classes="Action" Content="居中" Command="{Binding SetTextPlacementCommand}" CommandParameter="center" HorizontalAlignment="Stretch"/>
         <Button Grid.Column="2" Classes="Action" Content="靠下" Command="{Binding SetTextPlacementCommand}" CommandParameter="bottom" HorizontalAlignment="Stretch"/>
        </Grid>
        <Expander Header="更多文字设置"><StackPanel Spacing="8" Margin="0,8,0,0">
         <TextBlock Classes="Label" Text="副标题"/><TextBox Text="{Binding Subtitle}" TextWrapping="Wrap" AcceptsReturn="True" IsUndoEnabled="False"/>
         <TextBlock Classes="Label" Text="栏目"/><TextBox Text="{Binding Column}" IsUndoEnabled="False"/>
         <TextBlock Classes="Label" Text="行距"/><Slider Minimum="1" Maximum="2" Value="{Binding LineHeight}" PointerReleased="OnGestureEnd"/>
         <TextBlock Classes="Label" Text="文字区域宽度"/><Slider Minimum=".25" Maximum="1" Value="{Binding TextWidth}" PointerReleased="OnGestureEnd"/>
         <Button Classes="Action" Content="重置文字位置" Command="{Binding ResetTextCommand}"/>
         <StackPanel Orientation="Horizontal" Spacing="6"><Button Classes="Action" Content="添加标识" Command="{Binding SelectLogoCommand}"/><Button Classes="Action" Content="移除标识" Command="{Binding ClearLogoCommand}"/></StackPanel>
        </StackPanel></Expander>
       </StackPanel>
       <ToggleButton Classes="SectionHeader" Content="底色与裁切" IsChecked="False" x:Name="CropSection"/>
       <StackPanel Margin="12,8,12,14" Spacing="8" IsVisible="{Binding #CropSection.IsChecked}">
        <Grid ColumnDefinitions="*,110" ColumnSpacing="8"><TextBlock Classes="Label" Text="底色"/><TextBox Grid.Column="1" Text="{Binding BackgroundColor}" IsUndoEnabled="False"/></Grid>
        <TextBlock Classes="Label" Text="背景遮罩"/><Slider Minimum="0" Maximum="1" Value="{Binding Scrim}" PointerReleased="OnGestureEnd"/>
        <CheckBox Content="显示裁切参考线" IsChecked="{Binding ShowGuides}" FontSize="12"/>
        <CheckBox Content="手动调整裁切" IsChecked="{Binding Manual}" FontSize="12"/>
        <StackPanel IsVisible="{Binding Manual}" Spacing="8">
         <TextBlock Classes="Label" Text="头条裁切位置"/><Slider Minimum="0" Maximum="1" Value="{Binding HeadlineOffset}" PointerReleased="OnGestureEnd"/>
         <TextBlock Classes="Label" Text="次条裁切位置"/><Slider Minimum="0" Maximum="1" Value="{Binding SecondaryOffset}" PointerReleased="OnGestureEnd"/>
        </StackPanel>
       </StackPanel>
       <ToggleButton Classes="SectionHeader" Content="AI 辅助" IsChecked="{Binding IsAiExpanded}" x:Name="AiSection"/>
       <StackPanel Margin="12,8,12,14" Spacing="8" IsVisible="{Binding #AiSection.IsChecked}">
        <TextBlock Classes="Hint" Text="在设置中启用 AI 后，可生成短标题和背景提示词。" IsVisible="{Binding !IsAIEnabled}"/>
        <StackPanel IsEnabled="{Binding IsAIEnabled}" Spacing="8">
         <Button Classes="Action" Content="生成短标题候选" Command="{Binding SuggestTitlesCommand}" IsEnabled="{Binding !IsGeneratingAi}"/>
         <ItemsControl ItemsSource="{Binding TitleSuggestions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
          <Button Classes="Action" Margin="0,0,0,4" Content="{Binding}" Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).ChooseTitleCommand}" CommandParameter="{Binding}"/>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <ComboBox ItemsSource="{Binding PromptStyles}" SelectedItem="{Binding SelectedPromptStyle}" DisplayMemberBinding="{Binding Name}"/>
         <Button Classes="Action" Content="生成背景提示词" Command="{Binding GeneratePromptCommand}" IsEnabled="{Binding !IsGeneratingAi}"/>
         <Button Classes="Action" Content="取消生成" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsGeneratingAi}"/>
        </StackPanel>
        <TextBox Text="{Binding GeneratedPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="8" IsUndoEnabled="False"/>
        <Button Classes="Action" Content="复制提示词" Command="{Binding CopyPromptCommand}"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Border Grid.ColumnSpan="2" IsVisible="{Binding IsArticleImagePickerOpen}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Margin="16" Padding="16" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="选择文章图片" FontSize="14" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="Tool" Command="{Binding CloseArticleImagesCommand}"><fi:FluentIcon Icon="Dismiss" FontSize="14"/></Button></Grid>
     <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding ArticleImages}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ArticleCoverImage">
       <Button Width="180" Margin="0,0,12,12" Padding="8" Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).SelectArticleBackgroundCommand}" CommandParameter="{Binding}">
        <StackPanel Spacing="6"><Image Source="{Binding Thumbnail}" Height="100" Stretch="Uniform"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
