<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:models="using:StarBlogPublisher.Models"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
             x:Class="StarBlogPublisher.Views.CoverStudioView"
             x:DataType="vm:CoverStudioViewModel"
             x:Name="StudioRoot">
    <UserControl.Styles>
        <Style Selector="TextBlock.InspectorLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Panel Margin="16">
        <Grid ColumnDefinitions="*,320">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="8" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsFullPreview, Mode=OneWay}"
                                      Command="{Binding SetPreviewModeCommand}" CommandParameter="full">
                            <TextBlock Text="完整" />
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsHeadlinePreview, Mode=OneWay}"
                                      Command="{Binding SetPreviewModeCommand}" CommandParameter="headline">
                            <TextBlock Text="头条 2.35:1" />
                        </ToggleButton>
                        <ToggleButton Grid.Column="2" Classes="EditorMode" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsSecondaryPreview, Mode=OneWay}"
                                      Command="{Binding SetPreviewModeCommand}" CommandParameter="secondary">
                            <TextBlock Text="次条 1:1" />
                        </ToggleButton>
                    </Grid>
                    <TextBlock Text="{Binding PreviewCaption}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Panel>
                        <Image Source="{Binding Preview}" Stretch="Uniform"
                               IsVisible="{Binding HasPreview}" />
                        <StackPanel IsVisible="{Binding !HasPreview}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="6" Opacity="0.7">
                            <fi:FluentIcon Icon="Image" IconVariant="Regular" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="封面预览会出现在这里" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border IsVisible="{Binding IsFetchingRandomBackground}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,12" Padding="10,4" CornerRadius="4" Background="#CC000000">
                            <TextBlock Text="正在获取随机背景…" FontSize="12" Foreground="White" />
                        </Border>
                        <Border IsVisible="{Binding IsFetchingArticleBackground}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,12" Padding="10,4" CornerRadius="4" Background="#CC000000">
                            <TextBlock Text="正在读取文章图片…" FontSize="12" Foreground="White" />
                        </Border>
                    </Panel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="背景" FontWeight="SemiBold" />
                        <Button Command="{Binding SelectLocalBackgroundCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <fi:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="16" />
                                <TextBlock Text="选择本地图片" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowArticleImagesCommand}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasArticleImages}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <fi:FluentIcon Icon="Image" IconVariant="Regular" FontSize="16" />
                                <TextBlock Text="{Binding ArticleImagePickerLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock IsVisible="{Binding !HasArticleImages}" Text="文章正文中没有可用图片"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox Classes="InspectorInput" ItemsSource="{Binding RandomCoverProviders}"
                                      SelectedItem="{Binding SelectedRandomCoverProvider}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Command="{Binding PickRandomBackgroundCommand}"
                                    Classes="Compact" MinHeight="32">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                    <fi:FluentIcon Icon="ArrowShuffle" IconVariant="Regular" FontSize="15" />
                                    <TextBlock Text="换一张" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding BackgroundDescription}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="标题" FontWeight="SemiBold" />
                        <TextBox Classes="InspectorInput" Text="{Binding CoverTitle}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinLines="2" MaxLines="4" PlaceholderText="封面标题" />
                        <TextBlock Text="打开时使用文章标题，可以改成封面里要显示的字。" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="样式" FontWeight="SemiBold" />
                        <TextBlock Text="字号" Classes="InspectorLabel" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Slider Minimum="28" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True"
                                    Value="{Binding FontSize}" />
                            <TextBlock Grid.Column="1" Width="28" VerticalAlignment="Center"
                                       Text="{Binding FontSize, StringFormat={}{0:0}}" />
                        </Grid>
                        <TextBlock Text="{Binding FontSizeHint}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="颜色" Classes="InspectorLabel" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsWhiteColor, Mode=OneWay}"
                                          Command="{Binding SetTextColorCommand}" CommandParameter="white">
                                <TextBlock Text="白色" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsBlackColor, Mode=OneWay}"
                                          Command="{Binding SetTextColorCommand}" CommandParameter="black">
                                <TextBlock Text="黑色" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="2" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsCustomColor, Mode=OneWay}"
                                          Command="{Binding SetTextColorCommand}" CommandParameter="custom">
                                <TextBlock Text="自定义" />
                            </ToggleButton>
                        </Grid>
                        <TextBox Classes="InspectorInput" Text="{Binding CustomColorHex}"
                                 IsVisible="{Binding IsCustomColor}" PlaceholderText="#FFFFFF" />

                        <TextBlock Text="粗细" Classes="InspectorLabel" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsRegularWeight, Mode=OneWay}"
                                          Command="{Binding SetBoldCommand}" CommandParameter="false">
                                <TextBlock Text="常规" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsBold, Mode=OneWay}"
                                          Command="{Binding SetBoldCommand}" CommandParameter="true">
                                <TextBlock Text="加粗" />
                            </ToggleButton>
                        </Grid>

                        <TextBlock Text="对齐" Classes="InspectorLabel" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsLeftAlign, Mode=OneWay}"
                                          Command="{Binding SetTextAlignCommand}" CommandParameter="left">
                                <TextBlock Text="左对齐" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsCenterAlign, Mode=OneWay}"
                                          Command="{Binding SetTextAlignCommand}" CommandParameter="center">
                                <TextBlock Text="居中" />
                            </ToggleButton>
                        </Grid>

                        <TextBlock Text="位置" Classes="InspectorLabel" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsTopPlacement, Mode=OneWay}"
                                          Command="{Binding SetTextPlacementCommand}" CommandParameter="top">
                                <TextBlock Text="靠上" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsCenterPlacement, Mode=OneWay}"
                                          Command="{Binding SetTextPlacementCommand}" CommandParameter="center">
                                <TextBlock Text="居中" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="2" Classes="EditorMode" HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsBottomPlacement, Mode=OneWay}"
                                          Command="{Binding SetTextPlacementCommand}" CommandParameter="bottom">
                                <TextBlock Text="靠下" />
                            </ToggleButton>
                        </Grid>

                        <CheckBox Content="渐变遮罩" IsChecked="{Binding ShowScrim}" />
                        <TextBlock Text="压暗标题背后的背景，让字在照片上更清楚。" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Button Command="{Binding SaveImageCommand}" HorizontalAlignment="Stretch">
                            <TextBlock Text="保存图片" HorizontalAlignment="Center" />
                        </Button>
                        <Button Classes="Accent" Command="{Binding ApplyToWeChatCommand}" HorizontalAlignment="Stretch">
                            <TextBlock Text="用作公众号封面" HorizontalAlignment="Center" />
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
        <Border IsVisible="{Binding IsArticleImagePickerOpen}" Classes="Card" Padding="20"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="选择文章图片作为背景" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding CloseArticleImagesCommand}" Content="关闭" />
                </Grid>
                <TextBlock Grid.Row="1" Text="点击图片即可使用；之后仍可调整标题和样式。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding ArticleImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ArticleCoverImage">
                                <Button Width="180" Margin="0,0,12,12" Padding="8"
                                        HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Source}"
                                        Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).SelectArticleBackgroundCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="6">
                                        <Border Height="110" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Panel>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Panel>
</UserControl>
