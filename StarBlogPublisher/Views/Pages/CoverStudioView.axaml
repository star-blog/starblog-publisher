<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:StarBlogPublisher.ViewModels" xmlns:models="using:StarBlogPublisher.Models"
 xmlns:utils="clr-namespace:StarBlogPublisher.Utils;assembly=StarBlogPublisher.Core"
 xmlns:controls="using:StarBlogPublisher.Views.Controls"
 x:Class="StarBlogPublisher.Views.CoverStudioView" x:DataType="vm:CoverStudioViewModel" x:Name="StudioRoot">
 <UserControl.Styles>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="32"/></Style>
  <Style Selector="TextBlock.Hint"><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto">
   <StackPanel Orientation="Horizontal" Spacing="6">
    <Button Content="撤销" Command="{Binding UndoCommand}"/>
    <Button Content="重做" Command="{Binding RedoCommand}"/>
    <Button Content="属性" Command="{Binding ToggleInspectorCommand}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
    <Button Content="保存文章" Command="{Binding SaveArticleCommand}"/>
    <Button Content="导出图片" Command="{Binding SaveImageCommand}" IsEnabled="{Binding IsEditable}"/>
    <Button Content="应用到文章" Classes="Accent" Command="{Binding ApplyToWeChatCommand}" IsEnabled="{Binding IsEditable}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
   <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    <ItemsControl ItemsSource="{Binding Templates}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:CoverTemplate">
      <Button Margin="0,0,6,6" Content="{Binding Name}" IsEnabled="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).IsEditable}"
       Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).SelectTemplateCommand}" CommandParameter="{Binding}"/>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
     <TextBlock Text="拖动调整" VerticalAlignment="Center"/>
     <ComboBox SelectedItem="{Binding DragTarget}" MinWidth="90">
      <x:String>背景</x:String><x:String>文字</x:String>
     </ComboBox>
     <TextBlock Classes="Hint" Text="1200 × 900 · 滚轮缩放背景" VerticalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" ClipToBounds="True"><Panel>
     <Image x:Name="CanvasImage" Source="{Binding Preview}" Stretch="Uniform" PointerPressed="OnCanvasPressed"
      PointerMoved="OnCanvasMoved" PointerReleased="OnCanvasReleased" PointerWheelChanged="OnCanvasWheel"/>
      <controls:CoverGuides x:Name="Guides" IsHitTestVisible="False"/>
    </Panel></Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,150" ColumnSpacing="12" MaxHeight="170">
     <StackPanel Spacing="4"><TextBlock Classes="Hint" Text="头条 · 2.35:1"/><Image Source="{Binding HeadlinePreview}" Stretch="Uniform" MaxHeight="140"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="Hint" Text="次条 · 1:1"/><Image Source="{Binding SecondaryPreview}" Stretch="Uniform" MaxHeight="140"/></StackPanel>
    </Grid>
   </Grid>
   <Border Grid.Column="1" Width="300" IsVisible="{Binding IsInspectorOpen}" BorderThickness="1,0,0,0"
    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="12,0,0,0">
    <TabControl SelectedIndex="{Binding InspectorTab}" IsEnabled="{Binding IsEditable}">
     <TabItem Header="内容"><ScrollViewer><StackPanel Spacing="10" Margin="0,10,4,0">
      <TextBlock Text="封面标题" FontWeight="SemiBold"/>
      <TextBox Text="{Binding CoverTitle}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" IsUndoEnabled="False"/>
      <Button Content="同步文章标题" Command="{Binding SyncTitleCommand}"/>
      <TextBlock Text="副标题"/><TextBox Text="{Binding Subtitle}" AcceptsReturn="True" TextWrapping="Wrap" IsUndoEnabled="False"/>
      <TextBlock Text="栏目名"/><TextBox Text="{Binding Column}" IsUndoEnabled="False"/>
      <Button Content="选择标识图片" Command="{Binding SelectLogoCommand}"/>
      <Button Content="移除标识" Command="{Binding ClearLogoCommand}"/>
      <TextBlock Text="导出格式"/><ComboBox SelectedItem="{Binding ExportFormat}" HorizontalAlignment="Stretch"><x:String>JPEG</x:String><x:String>PNG</x:String></ComboBox>
      <TextBlock Text="导出范围"/><ComboBox SelectedItem="{Binding ExportRange}" HorizontalAlignment="Stretch"><x:String>完整画布</x:String><x:String>头条</x:String><x:String>次条</x:String></ComboBox>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="背景"><ScrollViewer><StackPanel Spacing="10" Margin="0,10,4,0">
      <Button Content="选择本地图片" Command="{Binding SelectLocalBackgroundCommand}" HorizontalAlignment="Stretch"/>
      <Button Content="{Binding ArticleImagePickerLabel}" Command="{Binding ShowArticleImagesCommand}" IsEnabled="{Binding HasArticleImages}" HorizontalAlignment="Stretch"/>
      <ComboBox ItemsSource="{Binding RandomCoverProviders}" SelectedItem="{Binding SelectedRandomCoverProvider}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>
      <Button Content="获取随机背景" Command="{Binding PickRandomBackgroundCommand}"/>
      <TextBlock Classes="Hint" Text="{Binding BackgroundDescription}"/>
      <TextBlock Text="背景缩放"/><Slider Minimum="1" Maximum="4" Value="{Binding Zoom}" PointerReleased="OnGestureEnd"/>
      <Button Content="重置构图" Command="{Binding ResetBackgroundCommand}"/>
      <Button Content="移除背景" Command="{Binding ClearBackgroundCommand}"/>
      <TextBlock Text="底色"/><TextBox Text="{Binding BackgroundColor}" IsUndoEnabled="False"/>
      <TextBlock Text="遮罩强度"/><Slider Minimum="0" Maximum="1" Value="{Binding Scrim}" PointerReleased="OnGestureEnd"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="样式"><ScrollViewer><StackPanel Spacing="10" Margin="0,10,4,0">
      <TextBlock Text="字号"/><Slider Minimum="24" Maximum="96" Value="{Binding FontSize}" PointerReleased="OnGestureEnd"/>
      <TextBlock Classes="Hint" Text="{Binding FontSizeHint}"/>
      <TextBlock Text="文字颜色"/><TextBox Text="{Binding TextColor}" IsUndoEnabled="False"/>
      <CheckBox Content="加粗" IsChecked="{Binding IsBold}"/><CheckBox Content="水平居中" IsChecked="{Binding Centered}"/>
      <TextBlock Text="行距"/><Slider Minimum="1" Maximum="2" Value="{Binding LineHeight}" PointerReleased="OnGestureEnd"/>
      <TextBlock Text="文本框宽度"/><Slider Minimum=".25" Maximum="1" Value="{Binding TextWidth}" PointerReleased="OnGestureEnd"/>
      <StackPanel Orientation="Horizontal" Spacing="4">
       <Button Content="靠上" Command="{Binding SetTextPlacementCommand}" CommandParameter="top"/>
       <Button Content="居中" Command="{Binding SetTextPlacementCommand}" CommandParameter="center"/>
       <Button Content="靠下" Command="{Binding SetTextPlacementCommand}" CommandParameter="bottom"/>
      </StackPanel>
      <CheckBox Content="手动构图" IsChecked="{Binding Manual}"/>
      <CheckBox Content="显示裁切与安全区参考线" IsChecked="{Binding ShowGuides}"/>
      <TextBlock Classes="Hint" Text="默认在两种比例共同安全区排字。手动模式允许自由布局，请检查裁切预览。"/>
      <StackPanel IsVisible="{Binding Manual}" Spacing="8">
       <TextBlock Text="头条裁切位置"/><Slider Minimum="0" Maximum="1" Value="{Binding HeadlineOffset}" PointerReleased="OnGestureEnd"/>
       <TextBlock Text="次条裁切位置"/><Slider Minimum="0" Maximum="1" Value="{Binding SecondaryOffset}" PointerReleased="OnGestureEnd"/>
      </StackPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="AI"><ScrollViewer><StackPanel Spacing="10" Margin="0,10,4,0">
      <TextBlock Classes="Hint" Text="在设置中启用 AI 后，可以构思背景和生成短标题。选中候选才会修改封面。"/>
      <StackPanel IsEnabled="{Binding IsAIEnabled}" Spacing="10">
       <Button Content="生成三个短标题" Command="{Binding SuggestTitlesCommand}" IsEnabled="{Binding !IsGeneratingAi}"/>
       <ItemsControl ItemsSource="{Binding TitleSuggestions}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
         <Button Content="{Binding}" Margin="0,0,0,6" Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).ChooseTitleCommand}" CommandParameter="{Binding}"/>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <ComboBox ItemsSource="{Binding PromptStyles}" SelectedItem="{Binding SelectedPromptStyle}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>
       <Button Content="构思背景提示词" Command="{Binding GeneratePromptCommand}" IsEnabled="{Binding !IsGeneratingAi}"/>
       <Button Content="取消生成" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsGeneratingAi}"/>
      </StackPanel>
      <TextBox Text="{Binding GeneratedPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="8" IsUndoEnabled="False"/>
      <Button Content="复制提示词" Command="{Binding CopyPromptCommand}"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="3"><TextBlock Classes="Hint" Text="{Binding SaveHint}"/><TextBlock Classes="Hint" Text="{Binding StatusMessage}"/></StackPanel>
  <Border Grid.RowSpan="3" IsVisible="{Binding IsArticleImagePickerOpen}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="16">
   <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="选择文章图片作为背景" FontSize="18"/><Button Grid.Column="1" Content="关闭" Command="{Binding CloseArticleImagesCommand}"/></Grid>
    <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding ArticleImages}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ArticleCoverImage">
      <Button Width="180" Margin="0,0,12,12" Padding="8" Command="{Binding #StudioRoot.((vm:CoverStudioViewModel)DataContext).SelectArticleBackgroundCommand}" CommandParameter="{Binding}">
       <StackPanel Spacing="6"><Image Source="{Binding Thumbnail}" Height="100" Stretch="Uniform"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</UserControl>
