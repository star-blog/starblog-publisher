<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:converters="clr-namespace:StarBlogPublisher.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="800"
             x:Class="StarBlogPublisher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="*,Auto">
        <suki:SettingsLayout Grid.Row="0">
            <suki:SettingsLayoutItem Header="后端">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="12">
                        <ToggleSwitch OnContent="使用自定义后端" OffContent="使用默认后端"
                                      IsChecked="{Binding UseCustomBackend}" />
                        <TextBlock Text="StarBlog后端URL" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBox Watermark="StarBlog后端URL" Text="{Binding BackendUrl}"
                                 IsEnabled="{Binding UseCustomBackend}" />
                        <TextBlock Text="用户名" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBox Watermark="用户名" Text="{Binding Username}" />
                        <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Watermark="密码"
                                     PasswordChar="{Binding ShowPassword, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                     Text="{Binding Password}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding TogglePasswordCommand}" Classes="Basic">
                                <i:Icon Value="fa-solid fa-eye" Foreground="#2196F3" />
                            </Button>
                        </Grid>
                        <TextBlock Text="超时时间（秒）" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <NumericUpDown Watermark="超时时间（秒）" Value="{Binding BackendTimeout}" Minimum="1" Maximum="600" />
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>

            <suki:SettingsLayoutItem Header="代理">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="12">
                        <ToggleSwitch OnContent="启用代理" OffContent="禁用代理" IsChecked="{Binding UseProxy}" />
                        <TextBlock Text="代理类型" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <ComboBox SelectedItem="{Binding ProxyType}" IsEnabled="{Binding UseProxy}" Width="200"
                                  HorizontalAlignment="Left">
                            <x:String>http</x:String>
                            <x:String>https</x:String>
                            <x:String>socks5</x:String>
                        </ComboBox>
                        <TextBlock Text="代理主机名" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBox Watermark="代理主机名" Text="{Binding ProxyHost}" IsEnabled="{Binding UseProxy}" />
                        <TextBlock Text="代理端口" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <NumericUpDown Watermark="代理端口" Value="{Binding ProxyPort}" Minimum="1" Maximum="65535"
                                       IsEnabled="{Binding UseProxy}" />
                        <TextBlock Text="代理超时时间（秒）" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <NumericUpDown Watermark="代理超时时间（秒）" Value="{Binding ProxyTimeout}" Minimum="1" Maximum="600"
                                       IsEnabled="{Binding UseProxy}" />
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>

            <suki:SettingsLayoutItem Header="微信">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="12">
                        <TextBlock Text="用于将排版后的文章上传到公众号草稿箱。AppSecret 会加密保存在本机。"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBlock Text="AppId" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBox Watermark="微信公众号 AppId" Text="{Binding WeChatAppId}" />
                        <TextBlock Text="AppSecret" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Watermark="微信公众号 AppSecret"
                                     PasswordChar="{Binding ShowWeChatAppSecret, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                     Text="{Binding WeChatAppSecret}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ToggleWeChatAppSecretCommand}" Classes="Basic">
                                <i:Icon Value="fa-solid fa-eye" Foreground="#2196F3" />
                            </Button>
                        </Grid>
                        <TextBlock Text="默认作者" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <TextBox Watermark="可留空" Text="{Binding WeChatAuthor}" />
                        <TextBlock Text="默认排版主题" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <ComboBox SelectedItem="{Binding WeChatDefaultTheme}">
                            <x:String>newspaper</x:String>
                            <x:String>warm-card</x:String>
                            <x:String>ocean-card</x:String>
                            <x:String>tech</x:String>
                        </ComboBox>
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>

            <suki:SettingsLayoutItem Header="图片">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="12">
                        <ToggleSwitch OnContent="启用正则识别" OffContent="仅使用标准识别"
                                      IsChecked="{Binding EnableRegexImageParsing}" />
                        <TextBlock Text="启用后将使用正则表达式额外识别带空格的图片路径，但可能会过度识别。建议仅在需要处理特殊路径时开启。"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>

            <suki:SettingsLayoutItem Header="外观">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="12">
                        <ToggleSwitch OnContent="深色模式" OffContent="浅色模式"
                                      IsChecked="{Binding IsDarkTheme}" />
                        <TextBlock Text="也可使用标题栏右侧的主题按钮切换。"
                                   FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>

            <suki:SettingsLayoutItem Header="AI">
                <suki:SettingsLayoutItem.Content>
                    <StackPanel Spacing="16">
                        <ToggleSwitch OnContent="启用AI" OffContent="禁用AI" IsChecked="{Binding EnableAI}" />

                        <TextBlock Text="配置文件" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}"
                                      DisplayMemberBinding="{Binding Name}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <Button ToolTip.Tip="添加新配置" Command="{Binding AddProfileCommand}" Classes="Basic">
                                    <i:Icon Value="fa-solid fa-plus" />
                                </Button>
                                <Button ToolTip.Tip="删除当前配置" Command="{Binding DeleteProfileCommand}" Classes="Basic">
                                    <i:Icon Value="fa-solid fa-trash" Foreground="#e53935" />
                                </Button>
                                <Button ToolTip.Tip="重命名当前配置" Command="{Binding RenameProfileCommand}" Classes="Basic">
                                    <i:Icon Value="fa-solid fa-pen-to-square" Foreground="#2196F3" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="选择AI提供商" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <ComboBox SelectedValue="{Binding AIProvider}"
                                  SelectedValueBinding="{Binding Name}"
                                  ItemsSource="{Binding AIProviders}"
                                  IsEnabled="{Binding EnableAI}"
                                  Width="220" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Watermark="输入对应提供商的API密钥"
                                     PasswordChar="{Binding ShowAIKey, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                     Text="{Binding AIKey}" IsEnabled="{Binding EnableAI}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ToggleAIKeyCommand}"
                                    Classes="Basic" IsEnabled="{Binding EnableAI}">
                                <i:Icon Value="fa-solid fa-eye" Foreground="#2196F3" />
                            </Button>
                            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding TestConnectionCommand}"
                                    ToolTip.Tip="测试API连接并加载模型列表" Classes="Basic" IsEnabled="{Binding EnableAI}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <i:Icon Value="fa-solid fa-vial" Foreground="#FF9800" />
                                    <TextBlock Text="测试" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="模型名称" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Text="{Binding AIModel}"
                                             ItemsSource="{Binding AvailableModels}"
                                             IsEnabled="{Binding EnableAI}"
                                             MinimumPopulateDelay="0" MinimumPrefixLength="0"
                                             IsTextCompletionEnabled="True" FilterMode="ContainsOrdinal"
                                             GotFocus="AutoCompleteBox_GotFocus" />
                            <ProgressBar Grid.Column="1" Margin="8,0,0,0" IsIndeterminate="True"
                                         IsVisible="{Binding IsLoadingModels}" Width="20" Height="20" />
                        </Grid>

                        <StackPanel Spacing="5" IsVisible="{Binding IsCustomProvider}">
                            <TextBlock Text="API Base URL" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                            <TextBox Watermark="API Base URL (仅自定义提供商需要)" Text="{Binding AIApiBase}" />
                        </StackPanel>

                        <TextBlock Text="{Binding AiStatusMessage}" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
                    </StackPanel>
                </suki:SettingsLayoutItem.Content>
            </suki:SettingsLayoutItem>
        </suki:SettingsLayout>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="16">
            <Button Command="{Binding CancelCommand}" Classes="Basic">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <i:Icon Value="fa-solid fa-ban" Foreground="#F44336" />
                    <TextBlock Text="还原" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}" Classes="Accent">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <i:Icon Value="fa-solid fa-save" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
