<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:converters="clr-namespace:StarBlogPublisher.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="800"
             x:Class="StarBlogPublisher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <x:Double x:Key="SettingsFieldWidth">320</x:Double>
        <x:Double x:Key="SettingsCompactControlWidth">140</x:Double>
        <fi:FluentIconSource x:Key="BlogIcon" Icon="Globe" IconVariant="Regular" />
        <fi:FluentIconSource x:Key="ProxyIcon" Icon="GlobeDesktop" IconVariant="Regular" />
        <fi:FluentIconSource x:Key="WeChatIcon" Icon="Chat" IconVariant="Regular" />
        <fi:FluentIconSource x:Key="ImageIcon" Icon="Image" IconVariant="Regular" />
        <fi:FluentIconSource x:Key="AppearanceIcon" Icon="DarkTheme" IconVariant="Regular" />
        <fi:FluentIconSource x:Key="AiIcon" Icon="Bot" IconVariant="Regular" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.SettingsField">
            <Setter Property="Width" Value="{StaticResource SettingsFieldWidth}" />
            <Setter Property="MinWidth" Value="{StaticResource SettingsFieldWidth}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      Offset="{Binding SettingsScrollOffset, Mode=TwoWay}">
            <StackPanel Classes="PageContent" MaxWidth="1000" HorizontalAlignment="Center" Spacing="4">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="更改发布服务、公众号、外观与 AI 的本地配置。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 博客与登录 -->
                <ui:FASettingsExpander Header="博客与登录"
                                     Description="StarBlog 服务地址和登录凭据"
                                     IconSource="{StaticResource BlogIcon}"
                                     IsExpanded="True">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch OnContent="自定义后端" OffContent="默认后端"
                                      IsChecked="{Binding UseCustomBackend}" />
                    </ui:FASettingsExpander.Footer>

                    <ui:FASettingsExpanderItem Content="后端 URL"
                                             Description="仅在启用自定义后端时生效">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="https://example.com"
                                         Text="{Binding BackendUrl}"
                                         IsEnabled="{Binding UseCustomBackend}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="用户名">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="用户名" Text="{Binding Username}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="密码">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="密码"
                                             PasswordChar="{Binding ShowPassword, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                             Text="{Binding Password}" />
                                    <Button Grid.Column="1" Classes="Icon"
                                            ToolTip.Tip="显示或隐藏密码"
                                            Command="{Binding TogglePasswordCommand}">
                                        <fi:FluentIcon Icon="Eye" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="超时时间"
                                             Description="范围为 1 至 600 秒">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ui:FANumberBox Value="{Binding BackendTimeout}"
                                              Minimum="1" Maximum="600"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact"
                                              Width="{StaticResource SettingsCompactControlWidth}"
                                              HorizontalAlignment="Right" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <!-- 网络代理 -->
                <ui:FASettingsExpander Header="网络代理"
                                     Description="用于连接 StarBlog 与 AI 服务的代理设置"
                                     IconSource="{StaticResource ProxyIcon}">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch OnContent="已启用" OffContent="已禁用"
                                      IsChecked="{Binding UseProxy}" />
                    </ui:FASettingsExpander.Footer>

                    <ui:FASettingsExpanderItem Content="代理类型">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ComboBox SelectedItem="{Binding ProxyType}"
                                          IsEnabled="{Binding UseProxy}"
                                          HorizontalAlignment="Stretch">
                                    <x:String>http</x:String>
                                    <x:String>https</x:String>
                                    <x:String>socks5</x:String>
                                </ComboBox>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="主机名">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="代理主机名"
                                         Text="{Binding ProxyHost}"
                                         IsEnabled="{Binding UseProxy}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="端口">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ui:FANumberBox Value="{Binding ProxyPort}"
                                              Minimum="1" Maximum="65535"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact"
                                              IsEnabled="{Binding UseProxy}"
                                              Width="{StaticResource SettingsCompactControlWidth}"
                                              HorizontalAlignment="Right" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="超时时间"
                                             Description="单位：秒">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ui:FANumberBox Value="{Binding ProxyTimeout}"
                                              Minimum="1" Maximum="600"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact"
                                              IsEnabled="{Binding UseProxy}"
                                              Width="{StaticResource SettingsCompactControlWidth}"
                                              HorizontalAlignment="Right" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <!-- 微信公众号 -->
                <ui:FASettingsExpander Header="微信公众号"
                                     Description="创建草稿箱所需的公众号凭据与默认值；AppSecret 会加密保存在本机"
                                     IconSource="{StaticResource WeChatIcon}">
                    <ui:FASettingsExpanderItem Content="公众号账号"
                                             Description="每个账号可使用独立的 AppId、AppSecret 和 relay 设置。">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding WeChatAccounts}"
                                              SelectedItem="{Binding CurrentWeChatAccount}"
                                              DisplayMemberBinding="{Binding DisplayName}" />
                                    <Button Grid.Column="1" Classes="Icon"
                                            ToolTip.Tip="添加公众号账号"
                                            Command="{Binding AddWeChatAccountCommand}">
                                        <fi:FluentIcon Icon="Add" IconVariant="Regular" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="Icon"
                                            ToolTip.Tip="删除当前公众号账号"
                                            Command="{Binding DeleteWeChatAccountCommand}">
                                        <fi:FluentIcon Icon="Delete" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="账号名称">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="例如：公司公众号"
                                         Text="{Binding WeChatAccountName}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="AppId">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="微信公众号 AppId"
                                         Text="{Binding WeChatAppId}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="微信 API Base URL"
                                             Description="默认使用官方地址。填写固定 IP 服务器上的反向代理地址时，代理需转发 /cgi-bin 路径。">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="https://api.weixin.qq.com/"
                                         Text="{Binding WeChatApiBaseUrl}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="微信 Relay Authorization"
                                             Description="仅在使用需要认证的 relay 时填写；填写完整 Authorization 值，例如 Bearer relay-token。该值会加密保存在本机。">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="Bearer relay-token"
                                             PasswordChar="{Binding ShowWeChatApiAuthorization, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                             Text="{Binding WeChatApiAuthorization}" />
                                    <Button Grid.Column="1" Classes="Icon"
                                            ToolTip.Tip="显示或隐藏 Authorization"
                                            Command="{Binding ToggleWeChatApiAuthorizationCommand}">
                                        <fi:FluentIcon Icon="Eye" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="AppSecret"
                                             Description="仅用于创建草稿，不会直接群发">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="微信公众号 AppSecret"
                                             PasswordChar="{Binding ShowWeChatAppSecret, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                             Text="{Binding WeChatAppSecret}" />
                                    <Button Grid.Column="1" Classes="Icon"
                                            ToolTip.Tip="显示或隐藏 AppSecret"
                                            Command="{Binding ToggleWeChatAppSecretCommand}">
                                        <fi:FluentIcon Icon="Eye" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="默认作者">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="可留空" Text="{Binding WeChatAuthor}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="默认排版主题">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ComboBox SelectedItem="{Binding WeChatDefaultTheme}"
                                          HorizontalAlignment="Stretch">
                                    <x:String>newspaper</x:String>
                                    <x:String>warm-card</x:String>
                                    <x:String>ocean-card</x:String>
                                    <x:String>tech</x:String>
                                </ComboBox>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <!-- 图片识别：单行开关 -->
                <ui:FASettingsExpander Header="图片识别"
                                     Description="启用后会额外识别带空格的路径，可能产生误判；仅在处理特殊路径时开启"
                                     IconSource="{StaticResource ImageIcon}">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch OnContent="正则识别" OffContent="标准识别"
                                      IsChecked="{Binding EnableRegexImageParsing}" />
                    </ui:FASettingsExpander.Footer>
                </ui:FASettingsExpander>

                <!-- 外观：单行开关 -->
                <ui:FASettingsExpander Header="外观"
                                     Description="也可从左侧栏底部的主题按钮快速切换"
                                     IconSource="{StaticResource AppearanceIcon}">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch OnContent="深色" OffContent="浅色"
                                      IsChecked="{Binding IsDarkTheme}" />
                    </ui:FASettingsExpander.Footer>
                </ui:FASettingsExpander>

                <!-- AI 创作 -->
                <ui:FASettingsExpander Header="AI 创作"
                                     Description="AI 提供商、模型与配置文件"
                                     IconSource="{StaticResource AiIcon}"
                                     IsExpanded="{Binding IsAiSettingsExpanded, Mode=TwoWay}">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch OnContent="已启用" OffContent="已禁用"
                                      IsChecked="{Binding EnableAI}" />
                    </ui:FASettingsExpander.Footer>

                    <ui:FASettingsExpanderItem Content="配置文件">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding CurrentProfile}"
                                              DisplayMemberBinding="{Binding Name}"
                                              IsEnabled="{Binding EnableAI}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="Icon" ToolTip.Tip="添加新配置"
                                                Command="{Binding AddProfileCommand}"
                                                IsEnabled="{Binding EnableAI}">
                                            <fi:FluentIcon Icon="Add" IconVariant="Regular" />
                                        </Button>
                                        <Button Classes="Icon" ToolTip.Tip="删除当前配置"
                                                Command="{Binding DeleteProfileCommand}"
                                                IsEnabled="{Binding EnableAI}">
                                            <fi:FluentIcon Icon="Delete" IconVariant="Regular" />
                                        </Button>
                                        <Button Classes="Icon" ToolTip.Tip="重命名当前配置"
                                                Command="{Binding RenameProfileCommand}"
                                                IsEnabled="{Binding EnableAI}">
                                            <fi:FluentIcon Icon="Edit" IconVariant="Regular" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="提供商">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <ComboBox SelectedValue="{Binding AIProvider}"
                                          SelectedValueBinding="{Binding Name}"
                                          ItemsSource="{Binding AIProviders}"
                                          IsEnabled="{Binding EnableAI}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="API Key">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="输入对应提供商的 API 密钥"
                                             PasswordChar="{Binding ShowAIKey, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"
                                             Text="{Binding AIKey}"
                                             IsEnabled="{Binding EnableAI}" />
                                    <Button Grid.Column="1" Classes="Icon"
                                            Command="{Binding ToggleAIKeyCommand}"
                                            ToolTip.Tip="显示或隐藏 API Key"
                                            IsEnabled="{Binding EnableAI}">
                                        <fi:FluentIcon Icon="Eye" IconVariant="Regular" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="Icon"
                                            Command="{Binding TestConnectionCommand}"
                                            ToolTip.Tip="测试 API 连接并加载模型列表"
                                            IsEnabled="{Binding EnableAI}">
                                        <fi:FluentIcon Icon="PlugConnected" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="模型">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding AIModel}"
                                             IsReadOnly="True"
                                             IsEnabled="{Binding EnableAI}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding OpenModelCatalogCommand}"
                                            IsEnabled="{Binding EnableAI}">
                                        <TextBlock Text="&#x9009;&#x62E9;&#x6A21;&#x578B;" />
                                    </Button>
                                    <ProgressBar Grid.Column="2"
                                                 IsIndeterminate="True"
                                                 IsVisible="{Binding IsLoadingModels}"
                                                 Width="24" Height="24"
                                                 VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="&#x6A21;&#x578B;&#x8BE6;&#x60C5;"
                                                 Description="{Binding AiModelDetails}" />

                    <ui:FASettingsExpanderItem Content="API Base URL"
                                             Description="仅自定义提供商需要"
                                             IsVisible="{Binding IsCustomProvider}">
                        <ui:FASettingsExpanderItem.Footer>
                            <Border Classes="SettingsField">
                                <TextBox PlaceholderText="https://api.example.com/v1"
                                         Text="{Binding AIApiBase}"
                                         IsEnabled="{Binding EnableAI}" />
                            </Border>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="状态"
                                             Description="{Binding AiStatusMessage}" />
                </ui:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding CancelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" />
                        <TextBlock Text="还原" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Classes="Accent">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <fi:FluentIcon Icon="Save" IconVariant="Regular" />
                        <TextBlock Text="保存更改" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
