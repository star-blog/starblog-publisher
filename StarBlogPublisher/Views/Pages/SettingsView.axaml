<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:StarBlogPublisher.ViewModels" xmlns:converters="clr-namespace:StarBlogPublisher.Converters" xmlns:ui="using:FluentAvalonia.UI.Controls" xmlns:controls="using:StarBlogPublisher.Views.Controls" x:Class="StarBlogPublisher.Views.SettingsView" x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.GroupTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="StackPanel.Field">
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="StackPanel.Form">
            <Setter Property="Spacing" Value="18"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.Rule">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Margin="32,24,32,20" MaxWidth="1080" ColumnDefinitions="176,*">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="管理本机的偏好、发布账号与服务连接" Classes="Hint" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="32,0,32,0" MaxWidth="1080" ColumnDefinitions="160,16,*">
            <ListBox x:Name="SettingsNavigation" SelectedIndex="{Binding SelectedSection}" VerticalAlignment="Top" Background="Transparent" BorderThickness="0">
                <ListBoxItem Content="常规" Padding="14,11"/>
                <ListBoxItem Content="{Binding BlogNavigationLabel}" Padding="14,11"/>
                <ListBoxItem Content="{Binding WeChatNavigationLabel}" Padding="14,11"/>
                <ListBoxItem Content="{Binding AiNavigationLabel}" Padding="14,11"/>
                <ListBoxItem Content="{Binding ProxyNavigationLabel}" Padding="14,11"/>
            </ListBox>
            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" Offset="{Binding SettingsScrollOffset, Mode=TwoWay}">
                <StackPanel x:Name="SettingsForm" MaxWidth="720" HorizontalAlignment="Stretch" Margin="12,0,16,32" Spacing="16">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12" CornerRadius="6" IsVisible="{Binding HasValidationError}">
                        <TextBlock Text="{Binding ValidationMessage}"/>
                    </Border>
                    <StackPanel Classes="Form" IsVisible="{Binding IsGeneralSection}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="常规" Classes="SectionTitle"/>
                            <TextBlock Classes="Hint" Text="让写作环境更合你的习惯。"/>
                        </StackPanel>
                        <TextBlock Classes="GroupTitle" Text="外观"/>
                        <ToggleSwitch Content="深色主题" IsChecked="{Binding IsDarkTheme}" OnContent="已开启" OffContent="已关闭"/>
                        <TextBlock Classes="Hint" Text="即时预览，保存后保留；撤销可恢复原主题。"/>
                        <Border Classes="Rule"/>
                        <TextBlock Classes="GroupTitle" Text="文章处理"/>
                        <ToggleSwitch Content="兼容含空格的图片路径" IsChecked="{Binding EnableRegexImageParsing}" OnContent="已开启" OffContent="已关闭"/>
                        <TextBlock Classes="Hint" Text="使用额外规则识别特殊图片路径，可能产生误判。通常无需开启。"/>
                    </StackPanel>
                    <StackPanel Classes="Form" IsVisible="{Binding IsBlogSection}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="博客连接" Classes="SectionTitle"/>
                            <TextBlock Classes="Hint" Text="配置 StarBlog 服务和登录凭据。"/>
                        </StackPanel>
                        <TextBlock Classes="GroupTitle" Text="服务地址"/>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton GroupName="BackendSource" Content="默认服务" IsChecked="{Binding !UseCustomBackend}"/>
                            <RadioButton GroupName="BackendSource" Content="自定义服务" IsChecked="{Binding UseCustomBackend}"/>
                        </StackPanel>
                        <StackPanel Classes="Form" IsVisible="{Binding !UseCustomBackend}">
                            <TextBlock Classes="Hint" Text="默认地址：https://blog.deali.cn/"/>
                        </StackPanel>
                        <StackPanel Classes="Form" IsVisible="{Binding UseCustomBackend}">
                            <StackPanel Classes="Field">
                                <TextBlock Text="服务 URL"/>
                                <TextBox Text="{Binding BackendUrl}" DataValidationErrors.Errors="{Binding BackendErrors}" PlaceholderText="https://blog.example.com/"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Classes="Rule"/>
                        <TextBlock Classes="GroupTitle" Text="登录凭据"/>
                        <StackPanel Classes="Field">
                            <TextBlock Text="用户名"/>
                            <TextBox Text="{Binding Username}" PlaceholderText="StarBlog 用户名"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="密码"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding Password}" PasswordChar="{Binding ShowPassword, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"/>
                                <Button Grid.Column="1" Content="显示 / 隐藏" Command="{Binding TogglePasswordCommand}"/>
                            </Grid>
                        </StackPanel>
                        <Expander Header="高级连接设置">
                            <StackPanel Classes="Form" Margin="0,12">
                                <StackPanel Classes="Field">
                                    <TextBlock Text="请求超时（秒）"/>
                                    <ui:FANumberBox Value="{Binding BackendTimeout}" Minimum="1" Maximum="600" SpinButtonPlacementMode="Compact" Width="160" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Classes="Form" IsVisible="{Binding IsWeChatSection}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="微信公众号" Classes="SectionTitle"/>
                            <TextBlock Classes="Hint" Text="配置用于创建公众号草稿的账号，不会直接群发。"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="当前账号（保存后用于发布）"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <ComboBox ItemsSource="{Binding WeChatAccounts}" SelectedItem="{Binding CurrentWeChatAccount}" DisplayMemberBinding="{Binding DisplayName}"/>
                                <Button Grid.Column="1" Content="添加账号" Command="{Binding AddWeChatAccountCommand}"/>
                                <Button Grid.Column="2" Content="···" ToolTip.Tip="更多操作" AutomationProperties.Name="更多操作">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="删除当前账号" Command="{Binding DeleteWeChatAccountCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="GroupTitle" Text="账号凭据"/>
                        <StackPanel Classes="Field">
                            <TextBlock Text="账号名称"/>
                            <TextBox Text="{Binding WeChatAccountName}" DataValidationErrors.Errors="{Binding AccountNameErrors}" PlaceholderText="用于区分不同公众号"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="AppId"/>
                            <TextBox Text="{Binding WeChatAppId}" PlaceholderText="公众号 AppId"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="AppSecret"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding WeChatAppSecret}" PasswordChar="{Binding ShowWeChatAppSecret, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"/>
                                <Button Grid.Column="1" Content="显示 / 隐藏" Command="{Binding ToggleWeChatAppSecretCommand}"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="Hint" Text="密钥加密保存在本机。"/>
                        <Border Classes="Rule"/>
                        <TextBlock Classes="GroupTitle" Text="发布默认值"/>
                        <StackPanel Classes="Field">
                            <TextBlock Text="默认作者 · 当前账号"/>
                            <TextBox Text="{Binding WeChatAuthor}" PlaceholderText="可留空"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="默认排版主题 · 所有账号"/>
                            <controls:WeChatThemePicker x:Name="WeChatThemeSelector"
                                                        SelectedThemeId="{Binding WeChatDefaultTheme}" />
                        </StackPanel>
                        <Expander Header="高级连接设置" x:Name="WeChatAdvanced" IsExpanded="{Binding IsWeChatAdvancedExpanded}">
                            <StackPanel Classes="Form" Margin="0,12">
                                <TextBlock Classes="Hint" Text="仅影响当前账号。默认使用微信官方接口。"/>
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <RadioButton GroupName="WeChatSource" Content="官方接口" IsChecked="{Binding !UseWeChatRelay}"/>
                                    <RadioButton GroupName="WeChatSource" Content="自定义中转" IsChecked="{Binding UseWeChatRelay}"/>
                                </StackPanel>
                                <StackPanel Classes="Form" IsVisible="{Binding UseWeChatRelay}">
                                    <StackPanel Classes="Field">
                                        <TextBlock Text="中转服务 URL"/>
                                        <TextBox Text="{Binding WeChatApiBaseUrl}" DataValidationErrors.Errors="{Binding RelayUrlErrors}" PlaceholderText="https://relay.example.com/"/>
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Text="使用固定 IP 的中转服务，需转发 /cgi-bin 路径。"/>
                                    <StackPanel Classes="Field">
                                        <TextBlock Text="中转认证（可选）"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding WeChatApiAuthorization}" DataValidationErrors.Errors="{Binding RelayAuthErrors}" PasswordChar="{Binding ShowWeChatApiAuthorization, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"/>
                                            <Button Grid.Column="1" Content="显示 / 隐藏" Command="{Binding ToggleWeChatApiAuthorizationCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Text="填写完整的 Authorization 值，如 Bearer relay-token，加密保存在本机。"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Classes="Form" IsVisible="{Binding IsAiSection}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="AI 创作" Classes="SectionTitle"/>
                            <TextBlock Classes="Hint" Text="管理服务与模型，关闭使用后仍可编辑配置。"/>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="当前配置方案（保存后用于创作）"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}" DisplayMemberBinding="{Binding Name}"/>
                                <Button Grid.Column="1" Content="添加方案" Command="{Binding AddProfileCommand}"/>
                                <Button Grid.Column="2" Content="···" ToolTip.Tip="更多操作" AutomationProperties.Name="更多操作">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="重命名" Command="{Binding RenameProfileCommand}"/>
                                            <MenuItem Header="删除当前方案" Command="{Binding DeleteProfileCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <ToggleSwitch Content="使用此方案的 AI 创作" IsChecked="{Binding EnableAI}" OnContent="已开启" OffContent="已关闭"/>
                        <Border Classes="Rule"/>
                        <TextBlock Classes="GroupTitle" Text="服务凭据"/>
                        <StackPanel Classes="Field">
                            <TextBlock Text="提供商"/>
                            <ComboBox SelectedItem="{Binding SelectedAIProvider}" ItemsSource="{Binding AIProviders}" DisplayMemberBinding="{Binding DisplayName}"/>
                        </StackPanel>
                        <StackPanel Classes="Form" IsVisible="{Binding IsCustomProvider}">
                            <StackPanel Classes="Field">
                                <TextBlock Text="API Base URL"/>
                                <TextBox Text="{Binding AIApiBase}" DataValidationErrors.Errors="{Binding AiUrlErrors}" PlaceholderText="https://api.example.com/v1"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Classes="Field">
                            <TextBlock Text="API Key"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding AIKey}" PasswordChar="{Binding ShowAIKey, Converter={x:Static converters:BooleanToCharConverter.Instance}, ConverterParameter=*}"/>
                                <Button Grid.Column="1" Content="显示 / 隐藏" Command="{Binding ToggleAIKeyCommand}"/>
                            </Grid>
                        </StackPanel>
                        <Button Content="获取模型" Command="{Binding RefreshModelsCommand}"/>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingModels}" Height="3"/>
                        <TextBlock Text="{Binding AiStatusMessage}" Classes="Hint"/>
                        <TextBlock Classes="Hint" Text="使用当前填写的凭据获取目录，不会保存配置，也不代表已验证模型调用能力。"/>
                        <Border Classes="Rule"/>
                        <TextBlock Classes="GroupTitle" Text="创作模型"/>
                        <StackPanel Classes="Field">
                            <TextBlock Text="模型 ID"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding AIModel}" PlaceholderText="输入模型 ID，或从目录选择"/>
                                <Button Grid.Column="1" Content="选择模型" Command="{Binding OpenModelCatalogCommand}"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding AiModelDetails}" Classes="Hint"/>
                    </StackPanel>
                    <StackPanel Classes="Form" IsVisible="{Binding IsProxySection}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="网络代理" Classes="SectionTitle"/>
                            <TextBlock Classes="Hint" Text="用于连接 StarBlog 与 AI 服务；公众号中转在账号中单独配置。"/>
                        </StackPanel>
                        <ToggleSwitch Content="使用网络代理" IsChecked="{Binding UseProxy}" OnContent="已开启" OffContent="已关闭"/>
                        <StackPanel Classes="Form" IsVisible="{Binding UseProxy}">
                            <TextBlock Classes="GroupTitle" Text="代理服务器"/>
                            <StackPanel Classes="Field">
                                <TextBlock Text="代理类型"/>
                                <ComboBox SelectedItem="{Binding ProxyType}">
                                    <x:String>http</x:String>
                                    <x:String>https</x:String>
                                    <x:String>socks5</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Classes="Field">
                                <TextBlock Text="主机名"/>
                                <TextBox Text="{Binding ProxyHost}" PlaceholderText="127.0.0.1"/>
                            </StackPanel>
                            <StackPanel Classes="Field">
                                <TextBlock Text="端口"/>
                                <ui:FANumberBox Value="{Binding ProxyPort}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" Width="160" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Expander Header="高级连接设置">
                                <StackPanel Classes="Form" Margin="0,12">
                                    <StackPanel Classes="Field">
                                        <TextBlock Text="请求超时（秒）"/>
                                        <ui:FANumberBox Value="{Binding ProxyTimeout}" Minimum="1" Maximum="600" SpinButtonPlacementMode="Compact" Width="160" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid MaxWidth="1080" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding SaveStatus}" Classes="Hint" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="撤销更改" Command="{Binding CancelCommand}" IsEnabled="{Binding HasChanges}"/>
                    <Button Content="保存更改" Command="{Binding SaveCommand}" Classes="Accent" IsEnabled="{Binding HasChanges}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
