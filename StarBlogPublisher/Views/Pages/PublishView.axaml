<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:views="using:StarBlogPublisher.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="StarBlogPublisher.Views.PublishView"
             x:DataType="vm:PublishViewModel">
    <suki:SukiStackPage x:Name="PublishStack" Limit="3" AlwaysGoBackToFirstPage="True">
        <suki:SukiStackPage.Content>
            <views:PublishEditorView x:Name="EditorRoot" />
        </suki:SukiStackPage.Content>
    </suki:SukiStackPage>
</UserControl>
