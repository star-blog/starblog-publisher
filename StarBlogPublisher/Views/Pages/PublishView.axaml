<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:StarBlogPublisher.Views"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="StarBlogPublisher.Views.PublishView"
             x:DataType="vm:PublishViewModel">
    <controls:StackPageHost Breadcrumbs="{Binding Breadcrumbs}"
                            IsNavigating="{Binding IsStackNavigating}"
                            StackContent="{Binding ActiveStackPage}"
                            BreadcrumbClicked="OnBreadcrumbClicked"
                            Margin="0">
        <controls:StackPageHost.RootContent>
            <views:PublishEditorView />
        </controls:StackPageHost.RootContent>
    </controls:StackPageHost>
</UserControl>
