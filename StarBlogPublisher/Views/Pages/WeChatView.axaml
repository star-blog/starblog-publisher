<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             mc:Ignorable="d"
             x:Class="StarBlogPublisher.Views.WeChatView"
             x:DataType="vm:WeChatViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.InspectorLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|WeChatThemePicker ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !HasArticle}">
            <i:Icon Value="fa-brands fa-weixin" FontSize="36" Foreground="#07C160" />
            <TextBlock Text="先在「发布」页加载一篇 Markdown 文章" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock Text="文章会在这里生成适合公众号粘贴和草稿箱上传的排版。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <DockPanel IsVisible="{Binding HasArticle}">
            <Border DockPanel.Dock="Bottom" Classes="StatusBar">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WordCount, StringFormat=约 {0} 字}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Grid.Column="2" Text="{Binding DraftMediaId}" IsReadOnly="True"
                             IsVisible="{Binding HasDraftMediaId}" Width="150" Height="24" FontSize="11" />
                    <Button Grid.Column="3" Command="{Binding CopyDraftMediaIdCommand}" IsVisible="{Binding HasDraftMediaId}"
                            Classes="Compact">
                        <TextBlock Text="复制草稿 ID" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <NativeWebView Source="{Binding PreviewUri}" />

                <Border Grid.Column="1" Width="{Binding InspectorPaneWidth}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <Panel>
                        <DockPanel IsVisible="{Binding IsInspectorOpen}">
                            <Border DockPanel.Dock="Top" Classes="InspectorActions">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="4">
                                    <Button Classes="Icon" Height="32" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="收起排版设置">
                                        <fi:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="16" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="Icon" Height="32" Command="{Binding OpenPreviewCommand}" ToolTip.Tip="在浏览器中打开">
                                        <fi:FluentIcon Icon="Open" IconVariant="Regular" FontSize="16" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="Icon" Height="32" Command="{Binding GenerateFormatCommand}" ToolTip.Tip="重新排版">
                                        <fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="16" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="Accent" HorizontalAlignment="Stretch" Height="32" Padding="8,0"
                                            Command="{Binding CopyHtmlCommand}" IsEnabled="{Binding HasFormattedHtml}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                            <fi:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="16" />
                                            <TextBlock Text="复制到公众号" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Classes="InspectorActions" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="6">
                                    <ComboBox Classes="InspectorInput" ItemsSource="{Binding WeChatAccounts}"
                                              SelectedItem="{Binding SelectedWeChatAccount}"
                                              DisplayMemberBinding="{Binding DisplayName}"
                                              IsEnabled="{Binding HasWeChatAccounts}"
                                              PlaceholderText="选择公众号账号"
                                              HorizontalAlignment="Stretch" />
                                    <Button Command="{Binding UploadDraftCommand}" IsEnabled="{Binding !IsPublishing}" Classes="Accent"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                            <fi:FluentIcon Icon="ArrowUpload" IconVariant="Regular" FontSize="16" />
                                            <TextBlock Text="上传至草稿箱" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ToggleButton Classes="SectionHeader" Content="排版"
                                                  IsChecked="{Binding IsThemeSectionExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="排版" />
                                    <StackPanel Margin="12,8,12,12" Spacing="8"
                                                IsVisible="{Binding IsThemeSectionExpanded}">
                                        <controls:WeChatThemePicker SelectedTheme="{Binding SelectedTheme}" />
                                        <TextBlock Text="{Binding SelectedTheme.Description}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="切换后会自动刷新预览。" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ToggleButton Classes="SectionHeader" Content="基本属性"
                                                  IsChecked="{Binding IsBasicSectionExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="基本属性" />
                                    <StackPanel Margin="12,8,12,12" Spacing="10"
                                                IsVisible="{Binding IsBasicSectionExpanded}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="标题" Classes="InspectorLabel" />
                                                <TextBlock Grid.Column="1" Text="{Binding TitleCounterText}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBox Classes="InspectorInput" Text="{Binding ArticleTitle}"
                                                     PlaceholderText="公众号标题"
                                                     MaxLength="{Binding TitleMaxLength}" />
                                            <TextBlock Text="用于公众号草稿标题，最多 32 字。同步时优先采用 Markdown 的 title 或一级标题。"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="作者" Classes="InspectorLabel" />
                                                <TextBlock Grid.Column="1" Text="{Binding AuthorCounterText}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBox Classes="InspectorInput" Text="{Binding Author}"
                                                     PlaceholderText="作者"
                                                     MaxLength="{Binding AuthorMaxLength}" />
                                            <TextBlock Text="最多 16 字。切换公众号时会带入该账号的默认作者。"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="摘要" Classes="InspectorLabel" />
                                                <TextBlock Grid.Column="1" Text="{Binding DigestCounterText}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBox Classes="InspectorInput" Text="{Binding Digest}"
                                                     PlaceholderText="用于公众号草稿摘要，最多 120 字"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MaxLength="{Binding DigestMaxLength}"
                                                     MinHeight="72"
                                                     MaxHeight="120" />
                                            <TextBlock Text="独立于 StarBlog 文章摘要；从发布页同步时会自动带入并截断到 120 字。"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="阅读原文" Classes="InspectorLabel" />
                                            <TextBox Classes="InspectorInput" Text="{Binding ContentSourceUrl}"
                                                     PlaceholderText="https://example.com/p/article"
                                                     MaxLength="{Binding ContentSourceUrlMaxLength}" />
                                            <TextBlock Text="文章在 StarBlog 发布成功后，会自动填入文章地址。"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <CheckBox Content="打开评论" IsChecked="{Binding OpenComment}" />
                                            <CheckBox Content="仅粉丝可评论" IsChecked="{Binding FansOnlyComment}"
                                                      IsEnabled="{Binding OpenComment}" />
                                            <TextBlock Text="默认打开评论，所有人都可以评论。"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ToggleButton Classes="SectionHeader" Content="封面"
                                                  IsChecked="{Binding IsCoverSectionExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="封面" />
                                    <StackPanel Margin="12,8,12,12" Spacing="10"
                                                IsVisible="{Binding IsCoverSectionExpanded}">
                                        <Border Height="{Binding CoverPreviewHeight}" CornerRadius="6" ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Image Source="{Binding CoverPreview}" Stretch="UniformToFill"
                                                       IsVisible="{Binding HasCover}" />
                                                <StackPanel IsVisible="{Binding !HasCover}" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Spacing="4" Opacity="0.7">
                                                    <fi:FluentIcon Icon="Image" IconVariant="Regular" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="尚未选择封面图" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Border IsVisible="{Binding HasCover}" VerticalAlignment="Bottom" Padding="8,5"
                                                        Background="#99000000">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding CoverSourceDescription}" FontSize="10" MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" Foreground="White" />
                                                        <TextBlock Grid.Column="1" Text="已就绪" FontSize="10" Foreground="White" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" IsEnabled="{Binding !IsPreparingCover}">
                                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsLocalCoverSource, Mode=OneWay}"
                                                          Command="{Binding SetCoverSourceCommand}" CommandParameter="local">
                                                <TextBlock Text="本地" />
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsUrlCoverSource, Mode=OneWay}"
                                                          Command="{Binding SetCoverSourceCommand}" CommandParameter="url">
                                                <TextBlock Text="链接" />
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="2" Classes="EditorMode" HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsRandomCoverSource, Mode=OneWay}"
                                                          Command="{Binding SetCoverSourceCommand}" CommandParameter="random">
                                                <TextBlock Text="随机" />
                                            </ToggleButton>
                                        </Grid>

                                        <TextBlock Text="预览裁剪" Classes="InspectorLabel" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4" IsEnabled="{Binding !IsPreparingCover}">
                                            <ToggleButton Classes="EditorMode" HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsHeadlineCoverSize, Mode=OneWay}"
                                                          Command="{Binding SetCoverSizeCommand}" CommandParameter="headline">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="头条" FontSize="11" HorizontalAlignment="Center" />
                                                    <TextBlock Text="2.35:1" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Classes="EditorMode" HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsSecondaryCoverSize, Mode=OneWay}"
                                                          Command="{Binding SetCoverSizeCommand}" CommandParameter="secondary">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="次条" FontSize="11" HorizontalAlignment="Center" />
                                                    <TextBlock Text="1:1" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </Grid>

                                        <Button IsVisible="{Binding IsLocalCoverSource}" Command="{Binding SelectCoverCommand}"
                                                IsEnabled="{Binding !IsPreparingCover}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <fi:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="16" />
                                                <TextBlock Text="选择本地图片" />
                                            </StackPanel>
                                        </Button>

                                        <Grid IsVisible="{Binding IsUrlCoverSource}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox Classes="InspectorInput" Text="{Binding CoverUrl}" PlaceholderText="https://example.com/cover.jpg"
                                                     IsEnabled="{Binding !IsPreparingCover}" />
                                            <Button Grid.Column="1" Command="{Binding UseCoverUrlCommand}"
                                                    IsEnabled="{Binding !IsPreparingCover}" Classes="Compact">
                                                <TextBlock Text="使用" />
                                            </Button>
                                        </Grid>

                                        <StackPanel IsVisible="{Binding IsRandomCoverSource}" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <ComboBox Classes="InspectorInput" ItemsSource="{Binding RandomCoverProviders}" SelectedItem="{Binding SelectedRandomCoverProvider}"
                                                          DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding !IsPreparingCover}"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1" Command="{Binding PickRandomCoverCommand}"
                                                        IsEnabled="{Binding !IsPreparingCover}" Classes="Compact" MinHeight="32">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                                        <fi:FluentIcon Icon="ArrowShuffle" IconVariant="Regular" FontSize="15" />
                                                        <TextBlock Text="换一张" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="{Binding CoverCropDetail}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ToggleButton Classes="SectionHeader" Content="来源信息"
                                                  IsChecked="{Binding IsSourceSectionExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="来源信息" />
                                    <StackPanel Margin="12,8,12,12" IsVisible="{Binding IsSourceSectionExpanded}">
                                        <TextBlock Text="{Binding MarkdownSourceMessage}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ToggleButton Classes="SectionHeader" Content="HTML 源码"
                                                  IsChecked="{Binding IsHtmlSectionExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="HTML 源码" />
                                    <StackPanel Margin="12,8,12,12" IsVisible="{Binding IsHtmlSectionExpanded}">
                                        <TextBox Text="{Binding FormattedHtml}" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="160" FontSize="11"
                                                 FontFamily="Cascadia Code, Consolas, Menlo, Monospace" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <DockPanel IsVisible="{Binding !IsInspectorOpen}" Margin="4">
                            <Button DockPanel.Dock="Top" Classes="Icon" HorizontalAlignment="Stretch"
                                    Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="展开排版设置">
                                <fi:FluentIcon Icon="ChevronLeft" IconVariant="Regular" FontSize="16" />
                            </Button>
                            <Button DockPanel.Dock="Bottom" Classes="Icon" HorizontalAlignment="Stretch"
                                    Command="{Binding UploadDraftCommand}" IsEnabled="{Binding !IsPublishing}" ToolTip.Tip="上传至草稿箱">
                                <fi:FluentIcon Icon="ArrowUpload" IconVariant="Regular" FontSize="16" />
                            </Button>
                            <StackPanel Spacing="4" Margin="0,8,0,0">
                                <Button Classes="Icon" HorizontalAlignment="Stretch" Command="{Binding GenerateFormatCommand}" ToolTip.Tip="重新排版">
                                    <fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="16" />
                                </Button>
                                <Button Classes="Icon" HorizontalAlignment="Stretch" Command="{Binding OpenPreviewCommand}" ToolTip.Tip="在浏览器中打开">
                                    <fi:FluentIcon Icon="Open" IconVariant="Regular" FontSize="16" />
                                </Button>
                                <Button Classes="Icon" HorizontalAlignment="Stretch" Command="{Binding CopyHtmlCommand}"
                                        IsEnabled="{Binding HasFormattedHtml}" ToolTip.Tip="复制到公众号">
                                    <fi:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Panel>
                </Border>
            </Grid>
        </DockPanel>
    </Panel>
</UserControl>
