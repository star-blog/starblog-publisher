<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d"
             x:Class="StarBlogPublisher.Views.WeChatView"
             x:DataType="vm:WeChatViewModel">
    <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding !HasArticle}">
            <i:Icon Value="fa-brands fa-weixin" FontSize="36" Foreground="#07C160" />
            <TextBlock Text="请先在「发布」页加载 Markdown 文件" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16" IsVisible="{Binding HasArticle}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                <i:Icon Value="fa-brands fa-weixin" FontSize="25" Foreground="#07C160" />
                <StackPanel>
                    <TextBlock Text="公众号排版与草稿箱" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="生成微信兼容的内联样式 HTML；上传仅创建草稿，不会直接群发。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Classes="Card" Grid.Row="1" Margin="0,0,0,12" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:FluentIcon Icon="Info" IconVariant="Regular" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MarkdownSourceMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,220,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="排版主题" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberBinding="{Binding Name}" />
                <Button Grid.Column="2" Command="{Binding GenerateFormatCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <fi:FluentIcon Icon="Edit" IconVariant="Regular" />
                        <TextBlock Text="重新排版" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding WordCount, StringFormat=约 {0} 字}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="4" Command="{Binding OpenPreviewCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <fi:FluentIcon Icon="Eye" IconVariant="Regular" />
                        <TextBlock Text="浏览器预览" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="封面图" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" Text="{Binding CoverPath}" IsReadOnly="True" PlaceholderText="请选择 JPG 或 PNG 封面图" />
                <Button Grid.Column="2" Command="{Binding SelectCoverCommand}">
                    <TextBlock Text="选择封面" />
                </Button>
                <Button Grid.Column="3" Command="{Binding UploadDraftCommand}" IsEnabled="{Binding !IsPublishing}" Classes="Accent">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <fi:FluentIcon Icon="ArrowUpload" IconVariant="Regular" />
                        <TextBlock Text="上传草稿箱" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="4" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="微信排版 HTML" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Command="{Binding CopyHtmlCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:FluentIcon Icon="Copy" IconVariant="Regular" />
                            <TextBlock Text="复制到公众号" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding FormattedHtml}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontFamily="Consolas, Menlo, Monospace" />
            </Grid>

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Grid.Column="1" Text="{Binding DraftMediaId}" IsReadOnly="True" IsVisible="{Binding HasDraftMediaId}" Width="180" />
                <Button Grid.Column="2" Command="{Binding CopyDraftMediaIdCommand}" IsVisible="{Binding HasDraftMediaId}">
                    <TextBlock Text="复制草稿 ID" />
                </Button>
            </Grid>
        </Grid>
    </Panel>
</UserControl>
