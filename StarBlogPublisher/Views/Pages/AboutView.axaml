<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="700"
             x:Class="StarBlogPublisher.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="160" Height="160" />
                <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Classes="Card">
                <StackPanel Spacing="10" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-circle-info" Foreground="#2196F3" />
                        <TextBlock Text="基本信息" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Copyright}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="10" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-arrows-rotate" Foreground="#9C27B0" />
                        <TextBlock Text="软件更新" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                    <TextBlock Text="检查 GitHub Releases 中是否有新版。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Command="{Binding CheckForUpdateCommand}" Classes="Accent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="fa-solid fa-rotate" />
                                <TextBlock Text="检查更新" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="10" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-layer-group" Foreground="#4CAF50" />
                        <TextBlock Text="技术栈" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TechStack}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TechStackItem">
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <i:Icon Value="fa-solid fa-check-circle" Foreground="#4CAF50" Margin="0,0,5,0" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="基于 " />
                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Description}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="10" Margin="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-link" Foreground="#FF9800" />
                        <TextBlock Text="相关链接" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkItem">
                                <Button Command="{Binding OpenLinkCommand}" CommandParameter="{Binding Url}"
                                        HorizontalAlignment="Left" Padding="8" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <i:Icon Value="{Binding IconClass}" Foreground="{Binding IconColor}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Text}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
