<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:StarBlogPublisher.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:i="https://github.com/projektanker/icons.avalonia"
               mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
               x:Class="StarBlogPublisher.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="StarBlog Publisher"
               WindowStartupLocation="CenterScreen"
               MinWidth="900" MinHeight="640">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="Transparent"
                Height="40"
                Padding="12,0"
                wnd:AppWindow.AllowInteractionInTitleBar="True">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Width="18" Height="18" Source="/Assets/logo.png" />
                    <TextBlock Text="StarBlog Publisher"
                               VerticalAlignment="Center"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Classes="Transparent"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeTextConverter}}">
                        <Panel>
                            <i:Icon Value="fa-solid fa-moon" FontSize="16"
                                    IsVisible="{Binding !IsDarkTheme}" />
                            <i:Icon Value="fa-solid fa-sun" FontSize="16"
                                    IsVisible="{Binding IsDarkTheme}" />
                        </Panel>
                    </Button>
                    <Button Classes="Transparent"
                            Command="{Binding LoginCommand}"
                            IsVisible="{Binding !IsLoggedIn}"
                            ToolTip.Tip="登录">
                        <i:Icon Value="fa-solid fa-right-to-bracket" FontSize="16" />
                    </Button>
                    <Button Classes="Transparent"
                            Command="{Binding LogoutCommand}"
                            IsVisible="{Binding IsLoggedIn}"
                            ToolTip.Tip="登出">
                        <i:Icon Value="fa-solid fa-right-from-bracket" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationView PaneDisplayMode="Left"
                           IsSettingsVisible="False"
                           IsBackButtonVisible="False"
                           OpenPaneLength="220"
                           CompactPaneLength="48"
                           IsPaneOpen="True"
                           MenuItemsSource="{Binding Pages}"
                           SelectedItem="{Binding ActivePage, Mode=TwoWay}">
            <ui:NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:PageViewModelBase">
                    <ui:NavigationViewItem Content="{Binding Title}">
                        <ui:NavigationViewItem.IconSource>
                            <ui:SymbolIconSource Symbol="{Binding NavSymbol}" />
                        </ui:NavigationViewItem.IconSource>
                    </ui:NavigationViewItem>
                </DataTemplate>
            </ui:NavigationView.MenuItemTemplate>

            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="12,8" Spacing="4">
                    <TextBlock Text="{Binding LoginStatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SoftwareVersion, StringFormat=版本 {0}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <ContentControl Content="{Binding ActivePage}" Margin="8" />
        </ui:NavigationView>
    </DockPanel>
</wnd:AppWindow>
