<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:StarBlogPublisher.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:fi="using:FluentIcons.Avalonia.Fluent"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
               x:Class="StarBlogPublisher.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="StarBlog Publisher"
               WindowStartupLocation="CenterScreen"
               MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ui:NavigationView PaneDisplayMode="LeftCompact"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="False"
                       OpenPaneLength="220"
                       CompactPaneLength="48"
                       IsPaneOpen="False"
                       MenuItemsSource="{Binding Pages}"
                       SelectedItem="{Binding ActivePage, Mode=TwoWay}">
        <ui:NavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModelBase">
                <ui:NavigationViewItem Content="{Binding Title}"
                                       ToolTip.Tip="{Binding Title}">
                    <ui:NavigationViewItem.IconSource>
                        <fi:FluentIconSource Icon="{Binding NavIcon}" IconVariant="Regular" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </DataTemplate>
        </ui:NavigationView.MenuItemTemplate>

        <ui:NavigationView.PaneFooter>
            <StackPanel Margin="4,8" Spacing="4">
                <Button Classes="Transparent"
                        HorizontalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeTextConverter}}">
                    <Panel>
                        <fi:FluentIcon Icon="WeatherMoon" IconVariant="Regular" FontSize="16"
                                       IsVisible="{Binding !IsDarkTheme}" />
                        <fi:FluentIcon Icon="WeatherSunny" IconVariant="Regular" FontSize="16"
                                       IsVisible="{Binding IsDarkTheme}" />
                    </Panel>
                </Button>
                <Button Classes="Transparent"
                        HorizontalAlignment="Center"
                        Command="{Binding LoginCommand}"
                        IsVisible="{Binding !IsLoggedIn}"
                        ToolTip.Tip="登录">
                    <fi:FluentIcon Icon="Person" IconVariant="Regular" FontSize="16" />
                </Button>
                <Button Classes="Transparent"
                        HorizontalAlignment="Center"
                        Command="{Binding LogoutCommand}"
                        IsVisible="{Binding IsLoggedIn}"
                        ToolTip.Tip="登出">
                    <fi:FluentIcon Icon="SignOut" IconVariant="Regular" FontSize="16" />
                </Button>
            </StackPanel>
        </ui:NavigationView.PaneFooter>

        <Grid RowDefinitions="Auto,*">
            <ui:InfoBar x:Name="FeedbackBar"
                        Grid.Row="0"
                        Margin="8,4,8,0"
                        IsClosable="True"
                        IsOpen="False" />
            <ContentControl Grid.Row="1" Content="{Binding ActivePage}" />
        </Grid>
    </ui:NavigationView>
</wnd:AppWindow>
