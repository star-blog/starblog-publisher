<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:StarBlogPublisher.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:fi="using:FluentIcons.Avalonia.Fluent"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
               x:Class="StarBlogPublisher.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="{Binding WindowTitle}"
               WindowStartupLocation="CenterScreen"
               MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <ui:FANavigationView PaneDisplayMode="Left"
                           IsSettingsVisible="False"
                           IsBackButtonVisible="False"
                           OpenPaneLength="220"
                           CompactPaneLength="48"
                           IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                           MenuItemsSource="{Binding Pages}"
                           SelectedItem="{Binding ActivePage, Mode=TwoWay}">
            <ui:FANavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:PageViewModelBase">
                    <ui:FANavigationViewItem Content="{Binding Title}"
                                           ToolTip.Tip="{Binding Title}">
                        <ui:FANavigationViewItem.IconSource>
                            <fi:FluentIconSource Icon="{Binding NavIcon}" IconVariant="Regular" />
                        </ui:FANavigationViewItem.IconSource>
                    </ui:FANavigationViewItem>
                </DataTemplate>
            </ui:FANavigationView.MenuItemTemplate>

            <ui:FANavigationView.PaneFooter>
                <StackPanel Margin="8,8" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Transparent"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeTextConverter}}">
                            <Panel>
                                <fi:FluentIcon Icon="WeatherMoon" IconVariant="Regular" FontSize="16"
                                               IsVisible="{Binding !IsDarkTheme}" />
                                <fi:FluentIcon Icon="WeatherSunny" IconVariant="Regular" FontSize="16"
                                               IsVisible="{Binding IsDarkTheme}" />
                            </Panel>
                        </Button>
                        <Button Classes="Transparent"
                                Command="{Binding LoginCommand}"
                                IsVisible="{Binding !IsLoggedIn}"
                                ToolTip.Tip="登录">
                            <fi:FluentIcon Icon="Person" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button Classes="Transparent"
                                Command="{Binding LogoutCommand}"
                                IsVisible="{Binding IsLoggedIn}"
                                ToolTip.Tip="登出">
                            <fi:FluentIcon Icon="SignOut" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ui:FANavigationView.PaneFooter>

            <Grid RowDefinitions="Auto,*" Margin="{Binding TitleBarContentMargin}">
                <ui:FAInfoBar x:Name="FeedbackBar"
                            Grid.Row="0"
                            Margin="8,8,8,0"
                            IsClosable="True"
                            IsOpen="False" />
                <ContentControl Grid.Row="1" Content="{Binding ActivePage}" />
            </Grid>
        </ui:FANavigationView>

        <!-- Keep the drag surface clear of the NavigationView pane toggle (48px) and
             the system caption buttons (140px).  Otherwise it intercepts the centre
             of the hamburger button when content is extended into the title bar. -->
        <Border Height="{Binding TitleBarHeight}"
                Margin="48,0,140,0"
                VerticalAlignment="Top"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />
        <Border Height="{Binding TitleBarHeight}"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding ChromeTitle}"
                       Margin="{Binding TitleBarTitleMargin}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Panel>
</wnd:FAAppWindow>
