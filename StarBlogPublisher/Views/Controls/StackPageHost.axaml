<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:StarBlogPublisher.Views.Controls"
             x:Class="StarBlogPublisher.Views.Controls.StackPageHost">
    <DockPanel>
        <ui:FABreadcrumbBar DockPanel.Dock="Top"
                          Margin="4,0,4,8"
                          ItemsSource="{Binding Breadcrumbs, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}"
                          IsVisible="{Binding IsNavigating, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}"
                          ItemClicked="OnBreadcrumbItemClicked">
        </ui:FABreadcrumbBar>

        <Panel>
            <ContentControl Content="{Binding RootContent, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}"
                            IsVisible="{Binding !IsNavigating, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}" />
            <ContentControl Content="{Binding StackContent, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}"
                            IsVisible="{Binding IsNavigating, RelativeSource={RelativeSource AncestorType=local:StackPageHost}}" />
        </Panel>
    </DockPanel>
</UserControl>
