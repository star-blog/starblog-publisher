<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="InspectorRoot"
             x:Class="StarBlogPublisher.Views.Controls.ArticleInspectorView"
             x:DataType="vm:PublishViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="文章属性" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="×" Command="{Binding ToggleInspectorCommand}" Classes="Transparent" Padding="6,0" MinHeight="24" ToolTip.Tip="收起文章属性" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="发布目标" FontSize="12" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PublishTargetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="28" Padding="8,4">
                        <ComboBoxItem Content="StarBlog" />
                        <ComboBoxItem Content="微信公众号" />
                    </ComboBox>
                </Grid>
                <TextBlock Text="{Binding TargetReadinessText}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Content="登录" IsVisible="{Binding NeedsBlogLogin}" Command="{Binding RequestLoginCommand}" Padding="10,5" />
                    <Button Grid.Column="1" Content="{Binding PrimaryPublishLabel}" Command="{Binding PublishToTargetCommand}" IsEnabled="{Binding CanPublishToTarget}" Classes="Accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,5" />
                </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer>
            <StackPanel Margin="14,12" Spacing="12">
                <StackPanel Spacing="6" IsVisible="{Binding HasPublishResult}">
                    <TextBlock Text="已发布"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button HorizontalAlignment="Left"
                            Classes="Compact"
                            Command="{Binding ShowPublishResultCommand}">
                        <TextBlock Text="查看发布结果" />
                    </Button>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="标题" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                IsVisible="{Binding IsAIEnabled}"
                                IsEnabled="{Binding !IsRefiningTitle}"
                                ToolTip.Tip="优化标题">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="更清楚"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="Basic" />
                                    <MenuItem Header="更适合检索"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="WithReasoning" />
                                    <MenuItem Header="更短"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="Scenario" />
                                    <MenuItem Header="恢复原文" Command="{Binding ResetTitleCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding ArticleTitle}" PlaceholderText="文章标题" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="分类" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                IsVisible="{Binding HasSelectedCategory}"
                                Command="{Binding ClearCategoryCommand}"
                                ToolTip.Tip="清除已选分类">
                            <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Classes="CategorySelector"
                            IsVisible="{Binding IsLoggedIn}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding CategorySelectionHint}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Classes="CategorySelectorIcon">
                                <fi:FluentIcon Icon="Tag" IconVariant="Regular" FontSize="16"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategorySelectionText}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CategorySelectionHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <fi:FluentIcon Grid.Column="2" Icon="ChevronDown" IconVariant="Regular"
                                           FontSize="16" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <controls:CategoryPicker />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Text="登录后可选择文章分类"
                               IsVisible="{Binding !IsLoggedIn}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="摘要" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding RegenerateDescriptionCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成摘要">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding ArticleDescription}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="52"
                             MaxHeight="88"
                             PlaceholderText="文章摘要" />
                </StackPanel>

                <Expander Header="更多属性" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="关键词" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding GenerateKeywordsCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成关键词">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeywordItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Classes="Chip">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Classes="Transparent"
                                                Padding="2"
                                                Command="{Binding #InspectorRoot.((vm:PublishViewModel)DataContext).RemoveKeywordCommand}"
                                                CommandParameter="{Binding}">
                                            <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox PlaceholderText="添加关键词，按 Enter"
                             Text="{Binding NewKeywordText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Slug" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding GenerateSlugCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成 Slug">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding ArticleSlug}" PlaceholderText="url-slug" />
                </StackPanel>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
