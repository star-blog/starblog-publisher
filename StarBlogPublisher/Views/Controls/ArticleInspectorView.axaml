<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             xmlns:controls="using:StarBlogPublisher.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="InspectorRoot"
             x:Class="StarBlogPublisher.Views.Controls.ArticleInspectorView"
             x:DataType="vm:PublishViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.InspectorLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.InspectorTool">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.InspectorInput">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.InspectorAction">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.InspectorChip">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style Selector="Button.InspectorChipRemove">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.InspectorHeaderTool">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template"><ControlTemplate>
                <Border Name="HeaderActionSurface" Background="Transparent" CornerRadius="3">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter>
        </Style>
        <Style Selector="Button.InspectorHeaderTool:pointerover /template/ Border#HeaderActionSurface"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Style>
        <Style Selector="Button.InspectorHeaderTool:focus-visible /template/ Border#HeaderActionSurface"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Style>
        <Style Selector="Button.InspectorCategory">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,0">
                <TextBlock Text="文章属性" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding ToggleInspectorCommand}" Classes="InspectorHeaderTool" ToolTip.Tip="收起文章属性" AutomationProperties.Name="收起文章属性">
                    <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                </Button>
            </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Bottom">
            <ToggleButton Classes="SectionHeader" Content="发布"
                          IsChecked="{Binding IsPublishSectionExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="发布" />
            <StackPanel Spacing="6" Margin="12,8,12,10"
                        IsVisible="{Binding IsPublishSectionExpanded}">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Classes="InspectorAction" Command="{Binding ShowPublishResultCommand}"
                        Content="已发布 · 查看结果" IsVisible="{Binding HasPublishResult}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="发布目标" Classes="InspectorLabel" />
                    <ComboBox Grid.Column="1" Classes="InspectorInput" SelectedIndex="{Binding PublishTargetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="StarBlog" />
                        <ComboBoxItem Content="微信公众号" />
                    </ComboBox>
                </Grid>
                <TextBlock Text="{Binding TargetReadinessText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Button Content="登录" IsVisible="{Binding NeedsBlogLogin}" Command="{Binding RequestLoginCommand}" Classes="InspectorAction" />
                    <Button Grid.Column="1" Content="{Binding PrimaryPublishLabel}" Command="{Binding PublishToTargetCommand}" IsEnabled="{Binding CanPublishToTarget}" Classes="Accent InspectorAction" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ToggleButton Classes="SectionHeader" Content="基本属性"
                          IsChecked="{Binding IsBasicPropertiesExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="基本属性" />
            <StackPanel Margin="12,8,12,12" Spacing="10"
                        IsVisible="{Binding IsBasicPropertiesExpanded}">

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="标题" Classes="InspectorLabel" />
                        <Button Grid.Column="1"
                                Classes="Transparent InspectorTool"
                                IsVisible="{Binding IsAIEnabled}"
                                IsEnabled="{Binding !IsRefiningTitle}"
                                ToolTip.Tip="优化标题">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="更清楚"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="Basic" />
                                    <MenuItem Header="更适合检索"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="WithReasoning" />
                                    <MenuItem Header="更短"
                                              Command="{Binding RefineTitleWithTemplateCommand}"
                                              CommandParameter="Scenario" />
                                    <MenuItem Header="恢复原文" Command="{Binding ResetTitleCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBox Classes="InspectorInput" Text="{Binding ArticleTitle}" PlaceholderText="文章标题" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="分类" Classes="InspectorLabel" />
                        <Button Grid.Column="1"
                                Classes="Transparent InspectorTool"
                                IsVisible="{Binding HasSelectedCategory}"
                                Command="{Binding ClearCategoryCommand}"
                                ToolTip.Tip="清除已选分类">
                            <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Classes="InspectorCategory"
                            IsVisible="{Binding IsLoggedIn}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding CategorySelectionHint}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding CategorySelectionText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <fi:FluentIcon Grid.Column="1" Icon="ChevronDown" IconVariant="Regular"
                                           FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <controls:CategoryPicker />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="登录后选择文章分类"
                            IsVisible="{Binding !IsLoggedIn}"
                            Command="{Binding RequestLoginCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="InspectorCategory" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="摘要" Classes="InspectorLabel" />
                        <Button Grid.Column="1"
                                Classes="Transparent InspectorTool"
                                Command="{Binding RegenerateDescriptionCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成摘要">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <TextBox Classes="InspectorInput" Text="{Binding ArticleDescription}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="56"
                             MaxHeight="88"
                             PlaceholderText="文章摘要" />
                </StackPanel>

            </StackPanel>
            <ToggleButton Classes="SectionHeader" Content="高级属性"
                          IsChecked="{Binding IsAdvancedPropertiesExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="高级属性" />
            <StackPanel Spacing="10" Margin="12,8,12,12"
                        IsVisible="{Binding IsAdvancedPropertiesExpanded}">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="关键词" Classes="InspectorLabel" />
                        <Button Grid.Column="1"
                                Classes="Transparent InspectorTool"
                                Command="{Binding GenerateKeywordsCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成关键词">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeywordItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Classes="Chip InspectorChip">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                                        <Button Classes="Transparent InspectorChipRemove"
                                                Command="{Binding #InspectorRoot.((vm:PublishViewModel)DataContext).RemoveKeywordCommand}"
                                                CommandParameter="{Binding}">
                                            <fi:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Classes="InspectorInput" PlaceholderText="添加关键词，按 Enter"
                             Text="{Binding NewKeywordText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Slug" Classes="InspectorLabel" />
                        <Button Grid.Column="1"
                                Classes="Transparent InspectorTool"
                                Command="{Binding GenerateSlugCommand}"
                                IsVisible="{Binding IsAIEnabled}"
                                ToolTip.Tip="生成 Slug">
                            <fi:FluentIcon Icon="Sparkle" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </Grid>
                    <TextBox Classes="InspectorInput" Text="{Binding ArticleSlug}" PlaceholderText="url-slug" />
                </StackPanel>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
