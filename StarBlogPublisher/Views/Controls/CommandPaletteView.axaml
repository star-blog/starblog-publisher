<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels" x:Class="StarBlogPublisher.Views.Controls.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">
    <StackPanel Spacing="8" Width="520" MaxWidth="600">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="搜索文章；输入 &gt; 搜索命令" />
        <TextBlock Text="没有匹配项" IsVisible="{Binding !HasResults}" Margin="8" />
        <ListBox x:Name="Results" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" MaxHeight="330">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:PaletteEntry">
                <StackPanel Spacing="2"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding DisplayDetail}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" /></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="↑ ↓ 选择    Enter 执行    Esc 关闭" FontSize="11" Opacity="0.65" />
    </StackPanel>
</UserControl>
