<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:models="using:StarBlogPublisher.Models"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             Width="280"
             x:Class="StarBlogPublisher.Views.Controls.CategoryPicker"
             x:DataType="vm:PublishViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding ShowAddCategoryCommand}"
                    IsEnabled="{Binding IsLoggedIn}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:FluentIcon Icon="Add" IconVariant="Regular" FontSize="14" />
                    <TextBlock Text="新建分类" />
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding RefreshCategoriesCommand}"
                    IsEnabled="{Binding IsLoggedIn}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" FontSize="14" />
                    <TextBlock Text="刷新分类" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBox DockPanel.Dock="Top"
                 Watermark="搜索分类..."
                 Text="{Binding CategorySearchText}"
                 Margin="0,0,0,8" />

        <ListBox ItemsSource="{Binding FilteredCategories}"
                 SelectedItem="{Binding SelectedCategory}"
                 MinHeight="180"
                 MaxHeight="280">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
