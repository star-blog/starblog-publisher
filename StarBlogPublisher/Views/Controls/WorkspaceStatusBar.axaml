<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarBlogPublisher.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia.Fluent"
             x:Class="StarBlogPublisher.Views.Controls.WorkspaceStatusBar"
             x:DataType="vm:PublishViewModel">
    <Border Classes="StatusBar">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding SaveStatusText}" />
                <TextBlock FontSize="11" Opacity="0.45" Text="·" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding WordCount, StringFormat={}{0} 字}" />
                <TextBlock FontSize="11" Opacity="0.45" Text="·" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ImageCount, StringFormat={}{0} 张图片}" />
                <TextBlock FontSize="11" Opacity="0.45" Text="·" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="UTF-8" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="Transparent"
                        Padding="4,0"
                        Command="{Binding ToggleInspectorCommand}"
                        IsVisible="{Binding UseOverlayInspector}"
                        ToolTip.Tip="文章属性">
                    <fi:FluentIcon Icon="PanelRight" IconVariant="Regular" FontSize="14" />
                </Button>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding AiProviderLabel}"
                           IsVisible="{Binding IsAIEnabled}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ConnectionStatusText}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
