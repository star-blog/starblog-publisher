<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
    <Application>
        <!-- 添加需要在AOT中保留的程序集和类型 -->
        <Assembly Name="StarBlogPublisher" Dynamic="Required All" />
        <Assembly Name="Avalonia.Markup.Xaml" Dynamic="Required All" />
        <Assembly Name="Avalonia" Dynamic="Required All" />

        <!-- Refit相关程序集 -->
        <Assembly Name="Refit" Dynamic="Required All" />
        <Assembly Name="Newtonsoft.Json" Dynamic="Required All" />

        <!-- 添加API接口和模型类型 (重构后这些接口在 Core 程序集中) -->
        <Assembly Name="StarBlogPublisher.Core">
            <Type Name="StarBlogPublisher.Services.StarBlogApi.IAuth" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Services.StarBlogApi.ICategory" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Services.StarBlogApi.IBlogPost" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Services.StarBlogApi.ISite" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.SitePhoto" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.PageResult`1" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Dtos.LoginUser" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Dtos.CategoryCreationDto" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Dtos.PostCreationDto" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Dtos.PostUpdateDto" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Dtos.PostListQuery" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.LoginToken" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.Category" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.BlogPost" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.UploadImageResult" Dynamic="Required All" />
            <Type Name="StarBlogPublisher.Models.WordCloud" Dynamic="Required All" />
        </Assembly>
    </Application>
</Directives>
