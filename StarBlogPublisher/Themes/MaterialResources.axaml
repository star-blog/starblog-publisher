<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MaterialFallbackBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Standard.ShellBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Standard.SidebarBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Standard.WorkspaceCanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Standard.InspectorBackgroundBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="Material.Standard.WorkspaceChromeBrush" Color="#F9F9F9" />
            <!-- Mica overlays stay thinner than Acrylic so wallpaper tint remains visible. Canvas stays opaque. -->
            <SolidColorBrush x:Key="Material.Mica.ShellBackgroundBrush" Color="#80F3F3F3" />
            <SolidColorBrush x:Key="Material.Mica.MenuBackgroundBrush" Color="#80F9F9F9" />
            <SolidColorBrush x:Key="Material.Mica.SidebarBackgroundBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="Material.Mica.WorkspaceCanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Mica.InspectorBackgroundBrush" Color="#CCEEEEEE" />
            <SolidColorBrush x:Key="Material.Mica.WorkspaceChromeBrush" Color="#CCF9F9F9" />
            <SolidColorBrush x:Key="Material.Acrylic.ShellBackgroundBrush" Color="#99F3F3F3" />
            <ExperimentalAcrylicMaterial x:Key="Material.Acrylic.MenuMaterial"
                                        BackgroundSource="None" TintColor="#F9F9F9"
                                        TintOpacity="0.4" MaterialOpacity="0.08" FallbackColor="#F9F9F9" />
            <SolidColorBrush x:Key="Material.Acrylic.SidebarBackgroundBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="Material.Acrylic.WorkspaceCanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Material.Acrylic.InspectorBackgroundBrush" Color="#CCEEEEEE" />
            <SolidColorBrush x:Key="Material.Acrylic.WorkspaceChromeBrush" Color="#CCF9F9F9" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="WorkspaceChromeBrush" Color="#F9F9F9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MaterialFallbackBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Standard.ShellBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Standard.SidebarBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Standard.WorkspaceCanvasBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Standard.InspectorBackgroundBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="Material.Standard.WorkspaceChromeBrush" Color="#282828" />
            <SolidColorBrush x:Key="Material.Mica.ShellBackgroundBrush" Color="#80202020" />
            <SolidColorBrush x:Key="Material.Mica.MenuBackgroundBrush" Color="#802C2C2C" />
            <SolidColorBrush x:Key="Material.Mica.SidebarBackgroundBrush" Color="#593A3A3A" />
            <SolidColorBrush x:Key="Material.Mica.WorkspaceCanvasBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Mica.InspectorBackgroundBrush" Color="#CC1C1C1C" />
            <SolidColorBrush x:Key="Material.Mica.WorkspaceChromeBrush" Color="#CC282828" />
            <SolidColorBrush x:Key="Material.Acrylic.ShellBackgroundBrush" Color="#99202020" />
            <ExperimentalAcrylicMaterial x:Key="Material.Acrylic.MenuMaterial"
                                        BackgroundSource="None" TintColor="#2C2C2C"
                                        TintOpacity="0.8" MaterialOpacity="0.08" FallbackColor="#2C2C2C" />
            <SolidColorBrush x:Key="Material.Acrylic.SidebarBackgroundBrush" Color="#663A3A3A" />
            <SolidColorBrush x:Key="Material.Acrylic.WorkspaceCanvasBrush" Color="#202020" />
            <SolidColorBrush x:Key="Material.Acrylic.InspectorBackgroundBrush" Color="#CC1C1C1C" />
            <SolidColorBrush x:Key="Material.Acrylic.WorkspaceChromeBrush" Color="#CC282828" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#202020" />
            <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="WorkspaceChromeBrush" Color="#282828" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
